<section class="rr-services" id="services" style="background:{{ section.settings.background }};padding:{{ section.settings.padding }}px {{ section.settings.side_padding }}px;"><div class="rr-wrap"><div class="rr-reveal"><div class="rr-eyebrow" style="color:var(--sage);">{{ section.settings.eyebrow }}</div><h2 class="rr-heading" style="color:var(--butter);">{{ section.settings.heading }}</h2></div><div class="rr-service-grid">{%- for block in section.blocks -%}<article class="rr-service rr-reveal" {{ block.shopify_attributes }}><div class="rr-service__number">{{ block.settings.number }}</div><h3>{{ block.settings.title }}</h3><div class="rr-body">{{ block.settings.text }}</div></article>{%- endfor -%}</div></div></section>
<style>.rr-services{color:var(--butter)}.rr-service-grid{display:grid;gap:48px;grid-template-columns:repeat(3,minmax(0,1fr));margin-top:56px}.rr-service{border-top:1px solid rgba(244,236,216,.25);padding-top:24px}.rr-service__number{color:var(--sage);font:400 22px/1 Comfortaa,Jost,sans-serif}.rr-service h3{color:var(--butter);font:500 25px/1.18 Comfortaa,Jost,sans-serif;margin:18px 0 0}.rr-services .rr-body{color:rgba(244,236,216,.72)}@media(max-width:900px){.rr-services{padding-left:22px!important;padding-right:22px!important}.rr-service-grid{grid-template-columns:1fr}}</style>
{% schema %}
{"name":"RR services","settings":[{"type":"color","id":"background","label":"Background","default":"#24482d"},{"type":"range","id":"padding","label":"Section spacing","min":60,"max":180,"step":4,"unit":"px","default":110},{"type":"range","id":"side_padding","label":"Side spacing","min":0,"max":100,"step":2,"unit":"px","default":42},{"type":"text","id":"eyebrow","label":"Eyebrow","default":"What We Offer"},{"type":"text","id":"heading","label":"Heading","default":"Material, structure, and the route to shelf"}],"blocks":[{"type":"service","name":"Service","settings":[{"type":"text","id":"number","label":"Number","default":"01"},{"type":"text","id":"title","label":"Title","default":"Material Innovation"},{"type":"richtext","id":"text","label":"Description","default":"<p>Specialty papers and conscious sourcing, curated for touch as much as for the planet.</p>"}]}],"presets":[{"name":"RR services","blocks":[{"type":"service"},{"type":"service"},{"type":"service"}]}]}
{% endschema %}
