<section class="rr-hero" id="top" style="background:{{ section.settings.background }};padding:{{ section.settings.padding_top }}px {{ section.settings.side_padding }}px {{ section.settings.padding_bottom }}px;">
  <div class="rr-wrap" style="display:flex;flex-direction:column;gap:44px;">
    <div class="rr-reveal" style="max-width:920px;">
      <div class="rr-eyebrow">{{ section.settings.eyebrow }}</div>
      <h1 class="rr-heading" style="font-size:clamp(48px,7vw,88px);max-width:920px;">{{ section.settings.heading }}</h1>
      <div class="rr-body" style="font-size:18px;max-width:560px;">{{ section.settings.text }}</div>
      <div class="rr-hero__actions">
        {%- if section.settings.primary_label != blank -%}
          <a class="rr-hero-button rr-hero-button--{{ section.settings.primary_style }}" href="{{ section.settings.primary_link }}">
            <span>{{ section.settings.primary_label }}</span>
            {%- if section.settings.primary_arrow -%}
              <svg aria-hidden="true" viewBox="0 0 16 12" fill="none"><path d="M1 6h13M10 1.5 14.5 6 10 10.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
            {%- endif -%}
          </a>
        {%- endif -%}
        {%- if section.settings.secondary_label != blank -%}
          <a class="rr-hero-button rr-hero-button--{{ section.settings.secondary_style }}" href="{{ section.settings.secondary_link }}">
            <span>{{ section.settings.secondary_label }}</span>
            {%- if section.settings.secondary_arrow -%}
              <svg aria-hidden="true" viewBox="0 0 16 12" fill="none"><path d="M1 6h13M10 1.5 14.5 6 10 10.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
            {%- endif -%}
          </a>
        {%- endif -%}
      </div>
    </div>
    <div class="rr-reveal" style="display:grid;gap:16px;grid-template-columns:1.6fr 1fr;align-items:end;">
      <div style="background:{{ section.settings.image_background }};height:440px;overflow:hidden;">{%- if section.settings.hero_image != blank -%}{{ section.settings.hero_image | image_url: width:1800 | image_tag: loading:'eager', sizes:'100vw', alt:section.settings.image_alt }}{%- else -%}<img src="{{ 'rr-framer-hero.png' | asset_url }}" alt="{{ section.settings.image_alt | escape }}">{%- endif -%}</div>
      <div style="display:grid;gap:16px;"><div style="background:{{ section.settings.image_background }};height:212px;overflow:hidden;">{%- if section.settings.detail_image_1 != blank -%}{{ section.settings.detail_image_1 | image_url: width:900 | image_tag: loading:'lazy', alt:section.settings.image_alt }}{%- endif -%}</div><div style="background:{{ section.settings.image_background }};height:212px;overflow:hidden;">{%- if section.settings.detail_image_2 != blank -%}{{ section.settings.detail_image_2 | image_url: width:900 | image_tag: loading:'lazy', alt:section.settings.image_alt }}{%- endif -%}</div></div>
    </div>
    <div class="rr-reveal" style="align-items:center;border-top:1px solid var(--line);display:flex;flex-wrap:wrap;gap:32px;justify-content:space-between;padding-top:28px;"><span class="rr-eyebrow" style="color:var(--muted);">{{ section.settings.proof_label }}</span><div style="color:#999;font-size:17px;display:flex;flex-wrap:wrap;gap:32px 48px;">{{ section.settings.proof_names }}</div></div>
  </div>
</section>
<style>
  .rr-hero .rr-body em { color:var(--forest); font-style:normal; }
  .rr-hero .rr-eyebrow { margin-bottom:26px; }
  .rr-hero__actions { align-items:center; display:flex; flex-wrap:wrap; gap:20px; margin-top:28px; }
  .rr-hero-button { align-items:center; display:inline-flex; flex-shrink:0; font:500 11.5px/1 Jost,sans-serif; gap:10px; justify-content:center; letter-spacing:.1em; min-height:42px; text-transform:uppercase; transition:background-color .25s ease,color .25s ease,transform .25s ease; }
  .rr-hero-button svg { height:12px; transition:transform .25s ease; width:16px; }
  .rr-hero-button:hover svg { transform:translateX(3px); }
  .rr-hero-button--round { background:var(--forest); border:1px solid var(--forest); border-radius:999px; color:var(--butter); padding:12px 24px; }
  .rr-hero-button--round:hover { background:var(--dark); border-color:var(--dark); color:var(--butter); transform:translateY(-1px); }
  .rr-hero-button--text { background:transparent; border:0; border-radius:0; color:var(--ink); padding:12px 0; }
  .rr-hero-button--text:hover { color:var(--forest); }
  @media(max-width:900px){.rr-hero{padding-left:22px!important;padding-right:22px!important}.rr-hero .rr-reveal:nth-child(2){grid-template-columns:1fr}.rr-hero .rr-reveal:nth-child(2)>div:first-child{height:420px!important}.rr-hero .rr-reveal:nth-child(2)>div:last-child{display:none}}
  @media(max-width:600px){.rr-hero{padding-top:72px!important}.rr-hero .rr-reveal:nth-child(2)>div:first-child{height:330px!important}.rr-hero__actions{gap:12px 18px}}
</style>
{% schema %}
{"name":"RR hero","settings":[{"type":"color","id":"background","label":"Background","default":"#fafaf8"},{"type":"color","id":"image_background","label":"Image fallback background","default":"#efeae0"},{"type":"range","id":"padding_top","label":"Top spacing","min":48,"max":180,"step":4,"unit":"px","default":104},{"type":"range","id":"padding_bottom","label":"Bottom spacing","min":32,"max":140,"step":4,"unit":"px","default":56},{"type":"range","id":"side_padding","label":"Side spacing","min":0,"max":100,"step":2,"unit":"px","default":42},{"type":"text","id":"eyebrow","label":"Eyebrow","default":"Eco-Luxury Gift Packaging · Designed in Canada"},{"type":"text","id":"heading","label":"Heading","default":"Every package is a conversation."},{"type":"richtext","id":"text","label":"Text","default":"<p>We uncover the <em>root</em> of your brand, then design the <em>route</em> — holiday countdown boxes, blind boxes, and custom gift packaging that begins your customer's first impression.</p>"},{"type":"header","content":"Primary button"},{"type":"text","id":"primary_label","label":"Label","default":"START AN INQUIRY"},{"type":"url","id":"primary_link","label":"Link"},{"type":"select","id":"primary_style","label":"Style","options":[{"value":"round","label":"Round button"},{"value":"text","label":"Text"}],"default":"round"},{"type":"checkbox","id":"primary_arrow","label":"Show arrow","default":false},{"type":"header","content":"Secondary button"},{"type":"text","id":"secondary_label","label":"Label","default":"EXPLORE COLLECTIONS"},{"type":"url","id":"secondary_link","label":"Link"},{"type":"select","id":"secondary_style","label":"Style","options":[{"value":"round","label":"Round button"},{"value":"text","label":"Text"}],"default":"text"},{"type":"checkbox","id":"secondary_arrow","label":"Show arrow","default":true},{"type":"image_picker","id":"hero_image","label":"Hero image"},{"type":"image_picker","id":"detail_image_1","label":"Detail image 1"},{"type":"image_picker","id":"detail_image_2","label":"Detail image 2"},{"type":"text","id":"image_alt","label":"Image alt text","default":"Root & Route packaging"},{"type":"text","id":"proof_label","label":"Proof label","default":"Our atelier produces for"},{"type":"richtext","id":"proof_names","label":"Client names","default":"<p>MAC · Glo Beauty · Disney · Mentholatum · Harrods · Lido</p>"}],"presets":[{"name":"RR hero"}]}
{% endschema %}
