{%- liquid
  assign image_block = section.blocks | where: 'type', 'image' | first
-%}

{%- capture text_content -%}
  {%- for block in section.blocks -%}
    {%- case block.type -%}
      {%- when 'heading' -%}
        <div class="rr-hero__heading-block" {{ block.shopify_attributes }}>
          {%- if block.settings.eyebrow != blank -%}<div class="rr-hero__eyebrow">{{ block.settings.eyebrow }}</div>{%- endif -%}
          {%- if block.settings.heading != blank -%}<h1 class="rr-hero__heading">{{ block.settings.heading }}</h1>{%- endif -%}
        </div>
      {%- when 'description' -%}
        {%- if block.settings.text != blank -%}<div class="rr-hero__description" {{ block.shopify_attributes }}>{{ block.settings.text }}</div>{%- endif -%}
      {%- when 'button' -%}
        {%- if block.settings.label != blank -%}
          <a class="rr-hero-button rr-hero-button--{{ block.settings.style | default: 'round' }}" href="{{ block.settings.link }}" {{ block.shopify_attributes }}>
            <span>{{ block.settings.label }}</span>
            {%- if block.settings.show_arrow -%}
              <svg aria-hidden="true" viewBox="0 0 16 12" fill="none"><path d="M1 6h13M10 1.5 14.5 6 10 10.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
            {%- endif -%}
          </a>
        {%- endif -%}
    {%- endcase -%}
  {%- endfor -%}
{%- endcapture -%}

{%- capture image_content -%}
  {%- if image_block != blank -%}
    <div class="rr-hero__image" style="--image-height:{{ image_block.settings.height }}px;--image-height-mobile:{{ image_block.settings.height_mobile }}px;" {{ image_block.shopify_attributes }}>
      {%- if image_block.settings.image != blank -%}
        {{ image_block.settings.image | image_url: width: 3000 | image_tag: loading: 'eager', sizes: '100vw', alt: image_block.settings.alt }}
      {%- else -%}
        <img src="{{ 'rr-framer-hero.png' | asset_url }}" alt="{{ image_block.settings.alt | escape }}" width="2752" height="1536">
      {%- endif -%}
    </div>
  {%- endif -%}
{%- endcapture -%}

<section
  class="rr-hero rr-hero--{{ section.settings.text_position }} rr-reveal"
  id="top"
  style="--forest:{{ settings.rr_forest | default: '#2f5e3a' }};--dark:{{ settings.rr_deep_forest | default: '#24482d' }};--butter:{{ settings.rr_cream | default: '#f4ecd8' }};--ink:{{ settings.rr_ink | default: '#141414' }};--line:{{ settings.rr_hairline | default: '#ecebe6' }};--muted:#6b6b63;--overlay-text:{{ section.settings.overlay_text }};--overlay-color:{{ section.settings.overlay_color.rgb }};--overlay-opacity:{{ section.settings.overlay_opacity | divided_by: 100.0 }};--section-top:{{ section.settings.padding_top }}px;--section-bottom:{{ section.settings.padding_bottom }}px;--section-side:{{ section.settings.side_padding }}px;background:{{ section.settings.background }};"
>
  {%- if section.settings.text_position == 'overlay' -%}
    <div class="rr-hero__media"{% if image_block != blank %} style="--image-height:{{ image_block.settings.height }}px;--image-height-mobile:{{ image_block.settings.height_mobile }}px;"{% endif %}>
      {{ image_content }}
      <div class="rr-hero__scrim" aria-hidden="true"></div>
      <div class="rr-hero__text rr-hero__text--{{ section.settings.overlay_alignment }}">
        <div class="rr-hero__text-stack">{{ text_content }}</div>
      </div>
    </div>
  {%- elsif section.settings.text_position == 'below' -%}
    {{ image_content }}
    <div class="rr-hero__text"><div class="rr-hero__text-stack">{{ text_content }}</div></div>
  {%- else -%}
    <div class="rr-hero__text"><div class="rr-hero__text-stack">{{ text_content }}</div></div>
    {{ image_content }}
  {%- endif -%}
</section>

<style>
  .rr-hero { color:var(--ink); overflow:hidden; padding:var(--section-top) 0 var(--section-bottom); position:relative; }
  .rr-hero--overlay { padding:0; }
  .rr-hero__text { margin:0 auto; max-width:1360px; padding-left:var(--section-side); padding-right:var(--section-side); width:100%; }
  .rr-hero--above .rr-hero__text { margin-bottom:44px; }
  .rr-hero--below .rr-hero__text { margin-top:44px; }
  .rr-hero__text-stack { align-items:center; display:flex; flex-wrap:wrap; gap:20px; max-width:920px; }
  .rr-hero__heading-block,.rr-hero__description { flex:0 0 100%; width:100%; }
  .rr-hero__eyebrow { color:var(--forest); font:500 11px/1.3 Jost,sans-serif; letter-spacing:.3em; text-transform:uppercase; }
  .rr-hero__heading { color:inherit; font:500 clamp(48px,7vw,88px)/1.04 Comfortaa,Jost,sans-serif; letter-spacing:0; margin:20px 0 0; max-width:920px; }
  .rr-hero__description { color:var(--muted); font:300 18px/1.7 Jost,sans-serif; max-width:620px; }
  .rr-hero__description p { margin:0; }
  .rr-hero__description em { color:var(--forest); font-style:normal; }
  .rr-hero__image { background:{{ section.settings.image_background }}; height:var(--image-height); overflow:hidden; width:100%; }
  .rr-hero__image img { display:block; height:100%; object-fit:cover; width:100%; }
  .rr-hero__media { min-height:var(--image-height,680px); position:relative; }
  .rr-hero__media .rr-hero__image { inset:0; position:absolute; }
  .rr-hero__scrim { background:linear-gradient(90deg,rgba(var(--overlay-color),var(--overlay-opacity)) 0%,rgba(var(--overlay-color),calc(var(--overlay-opacity) * .72)) 46%,rgba(var(--overlay-color),0) 82%); inset:0; pointer-events:none; position:absolute; }
  .rr-hero--overlay .rr-hero__text { align-items:center; color:var(--overlay-text); display:flex; inset:0; padding-bottom:clamp(40px,7vw,100px); padding-top:clamp(40px,7vw,100px); position:absolute; z-index:1; }
  .rr-hero--overlay .rr-hero__text--center { justify-content:center; text-align:center; }
  .rr-hero--overlay .rr-hero__text--center .rr-hero__text-stack { justify-content:center; }
  .rr-hero--overlay .rr-hero__text--right { justify-content:flex-end; }
  .rr-hero--overlay .rr-hero__eyebrow,.rr-hero--overlay .rr-hero__description,.rr-hero--overlay .rr-hero__description em,.rr-hero--overlay .rr-hero-button--text { color:var(--overlay-text); }
  .rr-hero-button { align-items:center; display:inline-flex; flex:0 0 auto; font:500 11.5px/1 Jost,sans-serif; gap:10px; justify-content:center; letter-spacing:.1em; min-height:42px; text-decoration:none; text-transform:uppercase; transition:background-color .25s ease,color .25s ease,transform .25s ease; }
  .rr-hero-button svg { height:12px; transition:transform .25s ease; width:16px; }
  .rr-hero-button:hover svg { transform:translateX(3px); }
  .rr-hero-button--round { background:var(--forest); border:1px solid var(--forest); border-radius:999px; color:var(--butter); padding:12px 24px; }
  .rr-hero-button--round:hover { background:var(--dark); border-color:var(--dark); color:var(--butter); transform:translateY(-1px); }
  .rr-hero-button--text { background:transparent; border:0; color:var(--ink); padding:12px 0; }
  .rr-hero-button--text:hover { color:var(--forest); }
  @media(max-width:700px){.rr-hero{--section-side:20px!important;--section-top:72px!important}.rr-hero__heading{font-size:clamp(38px,12vw,54px)}.rr-hero__image,.rr-hero__media{height:var(--image-height-mobile);min-height:var(--image-height-mobile)}.rr-hero--above .rr-hero__text{margin-bottom:32px}.rr-hero--below .rr-hero__text{margin-top:32px}.rr-hero--overlay .rr-hero__text{align-items:flex-end}.rr-hero__scrim{background:linear-gradient(0deg,rgba(var(--overlay-color),var(--overlay-opacity)) 0%,rgba(var(--overlay-color),calc(var(--overlay-opacity) * .45)) 68%,rgba(var(--overlay-color),0) 100%)}}
</style>

{% schema %}
{
  "name": "RR hero",
  "max_blocks": 5,
  "settings": [
    { "type": "select", "id": "text_position", "label": "Text position", "options": [{ "value": "above", "label": "Above image" }, { "value": "overlay", "label": "Overlay image" }, { "value": "below", "label": "Below image" }], "default": "above" },
    { "type": "select", "id": "overlay_alignment", "label": "Overlay alignment", "options": [{ "value": "left", "label": "Left" }, { "value": "center", "label": "Center" }, { "value": "right", "label": "Right" }], "default": "left", "visible_if": "{{ section.settings.text_position == 'overlay' }}" },
    { "type": "color", "id": "overlay_text", "label": "Overlay text color", "default": "#f4ecd8", "visible_if": "{{ section.settings.text_position == 'overlay' }}" },
    { "type": "color", "id": "overlay_color", "label": "Overlay scrim color", "default": "#141414", "visible_if": "{{ section.settings.text_position == 'overlay' }}" },
    { "type": "range", "id": "overlay_opacity", "label": "Overlay scrim strength", "min": 0, "max": 90, "step": 5, "unit": "%", "default": 55, "visible_if": "{{ section.settings.text_position == 'overlay' }}" },
    { "type": "color", "id": "background", "label": "Background", "default": "#fafaf8" },
    { "type": "color", "id": "image_background", "label": "Image fallback background", "default": "#efeae0" },
    { "type": "range", "id": "padding_top", "label": "Top spacing", "min": 0, "max": 180, "step": 4, "unit": "px", "default": 104 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom spacing", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 56 },
    { "type": "range", "id": "side_padding", "label": "Text side spacing", "min": 16, "max": 100, "step": 2, "unit": "px", "default": 42 }
  ],
  "blocks": [
    { "type": "heading", "name": "Heading", "limit": 1, "settings": [{ "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Eco-Luxury Gift Packaging · Designed in Canada" }, { "type": "inline_richtext", "id": "heading", "label": "Heading", "default": "Every package is a conversation." }] },
    { "type": "description", "name": "Description", "limit": 1, "settings": [{ "type": "richtext", "id": "text", "label": "Text", "default": "<p>We uncover the <em>root</em> of your brand, then design the <em>route</em> — packaging that begins your customer's first impression.</p>" }] },
    { "type": "button", "name": "Button", "limit": 2, "settings": [{ "type": "text", "id": "label", "label": "Label", "default": "START AN INQUIRY" }, { "type": "url", "id": "link", "label": "Link" }, { "type": "select", "id": "style", "label": "Style", "options": [{ "value": "round", "label": "Round button" }, { "value": "text", "label": "Text" }], "default": "round" }, { "type": "checkbox", "id": "show_arrow", "label": "Show arrow", "default": false }] },
    { "type": "image", "name": "Hero image", "limit": 1, "settings": [{ "type": "image_picker", "id": "image", "label": "Image" }, { "type": "text", "id": "alt", "label": "Alt text", "default": "Root & Route packaging" }, { "type": "range", "id": "height", "label": "Desktop image height", "min": 360, "max": 1000, "step": 20, "unit": "px", "default": 680 }, { "type": "range", "id": "height_mobile", "label": "Mobile image height", "min": 280, "max": 720, "step": 20, "unit": "px", "default": 480 }] }
  ],
  "presets": [{ "name": "RR hero", "blocks": [{ "type": "heading" }, { "type": "description" }, { "type": "button" }, { "type": "button", "settings": { "label": "EXPLORE COLLECTIONS", "style": "text", "show_arrow": true } }, { "type": "image" }] }]
}
{% endschema %}
