<section class="rr-hero" id="top" style="background:{{ section.settings.background }};padding:{{ section.settings.padding_top }}px {{ section.settings.side_padding }}px {{ section.settings.padding_bottom }}px;">
  <div class="rr-wrap" style="display:flex;flex-direction:column;gap:44px;">
    <div class="rr-reveal" style="max-width:920px;">
      <div class="rr-eyebrow">{{ section.settings.eyebrow }}</div>
      <h1 class="rr-heading" style="font-size:clamp(48px,7vw,88px);max-width:920px;">{{ section.settings.heading }}</h1>
      <div class="rr-body" style="font-size:18px;max-width:560px;">{{ section.settings.text }}</div>
      <div style="align-items:center;display:flex;flex-wrap:wrap;gap:20px;margin-top:28px;"><a class="rr-button" href="{{ section.settings.primary_link }}">{{ section.settings.primary_label }}</a><a class="rr-link" href="{{ section.settings.secondary_link }}">{{ section.settings.secondary_label }}</a></div>
    </div>
    <div class="rr-reveal" style="display:grid;gap:16px;grid-template-columns:1.6fr 1fr;align-items:end;">
      <div style="background:{{ section.settings.image_background }};height:440px;overflow:hidden;">{%- if section.settings.hero_image != blank -%}{{ section.settings.hero_image | image_url: width:1800 | image_tag: loading:'eager', sizes:'100vw', alt:section.settings.image_alt }}{%- else -%}<img src="{{ 'rr-framer-hero.png' | asset_url }}" alt="{{ section.settings.image_alt | escape }}">{%- endif -%}</div>
      <div style="display:grid;gap:16px;"><div style="background:{{ section.settings.image_background }};height:212px;overflow:hidden;">{%- if section.settings.detail_image_1 != blank -%}{{ section.settings.detail_image_1 | image_url: width:900 | image_tag: loading:'lazy', alt:section.settings.image_alt }}{%- endif -%}</div><div style="background:{{ section.settings.image_background }};height:212px;overflow:hidden;">{%- if section.settings.detail_image_2 != blank -%}{{ section.settings.detail_image_2 | image_url: width:900 | image_tag: loading:'lazy', alt:section.settings.image_alt }}{%- endif -%}</div></div>
    </div>
    <div class="rr-reveal" style="align-items:center;border-top:1px solid var(--line);display:flex;flex-wrap:wrap;gap:32px;justify-content:space-between;padding-top:28px;"><span class="rr-eyebrow" style="color:var(--muted);">{{ section.settings.proof_label }}</span><div style="color:#999;font-size:17px;display:flex;flex-wrap:wrap;gap:32px 48px;">{{ section.settings.proof_names }}</div></div>
  </div>
</section>
<style>.rr-hero .rr-body em{color:var(--forest);font-style:normal}.rr-hero .rr-eyebrow{margin-bottom:26px}@media(max-width:900px){.rr-hero{padding-left:22px!important;padding-right:22px!important}.rr-hero .rr-reveal:nth-child(2){grid-template-columns:1fr}.rr-hero .rr-reveal:nth-child(2)>div:first-child{height:420px!important}.rr-hero .rr-reveal:nth-child(2)>div:last-child{display:none}}@media(max-width:600px){.rr-hero{padding-top:72px!important}.rr-hero .rr-reveal:nth-child(2)>div:first-child{height:330px!important}}</style>
{% schema %}
{"name":"RR hero","settings":[{"type":"color","id":"background","label":"Background","default":"#fafaf8"},{"type":"color","id":"image_background","label":"Image fallback background","default":"#efeae0"},{"type":"range","id":"padding_top","label":"Top spacing","min":48,"max":180,"step":4,"unit":"px","default":104},{"type":"range","id":"padding_bottom","label":"Bottom spacing","min":32,"max":140,"step":4,"unit":"px","default":56},{"type":"range","id":"side_padding","label":"Side spacing","min":0,"max":100,"step":2,"unit":"px","default":42},{"type":"text","id":"eyebrow","label":"Eyebrow","default":"Eco-Luxury Gift Packaging · Designed in Canada"},{"type":"text","id":"heading","label":"Heading","default":"Every package is a conversation."},{"type":"richtext","id":"text","label":"Text","default":"<p>We uncover the <em>root</em> of your brand, then design the <em>route</em> — holiday countdown boxes, blind boxes, and custom gift packaging that begins your customer's first impression.</p>"},{"type":"text","id":"primary_label","label":"Primary label","default":"START AN INQUIRY"},{"type":"url","id":"primary_link","label":"Primary link"},{"type":"text","id":"secondary_label","label":"Secondary label","default":"EXPLORE COLLECTIONS →"},{"type":"url","id":"secondary_link","label":"Secondary link"},{"type":"image_picker","id":"hero_image","label":"Hero image"},{"type":"image_picker","id":"detail_image_1","label":"Detail image 1"},{"type":"image_picker","id":"detail_image_2","label":"Detail image 2"},{"type":"text","id":"image_alt","label":"Image alt text","default":"Root & Route packaging"},{"type":"text","id":"proof_label","label":"Proof label","default":"Our atelier produces for"},{"type":"richtext","id":"proof_names","label":"Client names","default":"<p>MAC · Glo Beauty · Disney · Mentholatum · Harrods · Lido</p>"}],"presets":[{"name":"RR hero"}]}
{% endschema %}
