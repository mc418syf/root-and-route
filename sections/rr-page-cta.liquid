<section class="rr-page-cta" style="background:{{ section.settings.background }};padding:{{ section.settings.padding }}px 40px"><div class="rr-wrap rr-reveal"><div class="rr-eyebrow">{{ section.settings.eyebrow }}</div><h2>{{ section.settings.heading }}</h2><div class="rr-page-cta__buttons">{%- for block in section.blocks -%}<a class="rr-button{% if block.settings.secondary %} secondary{% endif %}" href="{{ block.settings.link }}" {{ block.shopify_attributes }}>{{ block.settings.label }}</a>{%- endfor -%}</div></div></section>
<style>.rr-page-cta{text-align:center}.rr-page-cta .rr-eyebrow{color:var(--sage)}.rr-page-cta h2{color:var(--butter);font:500 clamp(34px,5vw,64px)/1.08 Comfortaa,sans-serif;margin:28px auto 0;max-width:900px}.rr-page-cta__buttons{display:flex;flex-wrap:wrap;gap:18px;justify-content:center;margin-top:40px}.rr-page-cta .rr-button{background:var(--butter);border-color:var(--butter);color:var(--dark)}.rr-page-cta .rr-button.secondary{background:transparent;border-color:rgba(244,236,216,.4);color:var(--butter)}@media(max-width:600px){.rr-page-cta{padding:82px 20px!important}.rr-page-cta__buttons{display:grid}.rr-page-cta .rr-button{width:100%}}</style>
{% schema %}
{"name":"RR page CTA","settings":[{"type":"color","id":"background","label":"Background","default":"#2f5e3a"},{"type":"range","id":"padding","label":"Section spacing","min":60,"max":180,"step":4,"unit":"px","default":130},{"type":"text","id":"eyebrow","label":"Eyebrow","default":"Let's Build It"},{"type":"text","id":"heading","label":"Heading","default":"Have an idea that doesn't exist yet?"}],"blocks":[{"type":"button","name":"Button","settings":[{"type":"text","id":"label","label":"Label","default":"START A PACKAGING PROJECT →"},{"type":"url","id":"link","label":"Link"},{"type":"checkbox","id":"secondary","label":"Secondary style","default":false}]}],"presets":[{"name":"RR page CTA","blocks":[{"type":"button"},{"type":"button","settings":{"secondary":true,"label":"VIEW OUR PROCESS →"}}]}]}
{% endschema %}
