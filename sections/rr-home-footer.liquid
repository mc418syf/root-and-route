<footer class="rr-footer" id="contact" style="background:{{ section.settings.background }};padding:{{ section.settings.padding }}px {{ section.settings.side_padding }}px 36px;"><div class="rr-wrap"><div class="rr-footer__cta rr-reveal"><h2 class="rr-heading">{{ section.settings.heading }}</h2><a class="rr-button" href="{{ section.settings.cta_link }}" style="background:var(--butter);border-color:var(--butter);color:var(--dark);margin-top:34px;">{{ section.settings.cta_label }}</a></div><div class="rr-footer__grid"><div><img class="rr-footer__logo" src="{{ 'rr-logo-light.png' | asset_url }}" alt="{{ section.settings.logo_alt | escape }}"></div><div><div class="rr-eyebrow">{{ section.settings.studio_heading }}</div><div class="rr-footer__links">{%- if section.settings.menu != blank -%}{%- for link in section.settings.menu.links -%}<a href="{{ link.url }}">{{ link.title }}</a>{%- endfor -%}{%- else -%}<a href="#collections">{{ section.settings.link_1 }}</a><a href="#services">{{ section.settings.link_2 }}</a><a href="#journey">{{ section.settings.link_3 }}</a>{%- endif -%}</div></div><div><div class="rr-eyebrow">{{ section.settings.contact_heading }}</div><div class="rr-footer__links"><a href="{{ section.settings.cta_link }}">{{ section.settings.cta_label }}</a><p>{{ section.settings.email }}</p><p>{{ section.settings.location }}</p></div></div></div><div class="rr-legal">{{ section.settings.legal }}</div></div></footer>
<style>.rr-footer{color:var(--butter)}.rr-footer__cta{text-align:center}.rr-footer__cta .rr-heading{color:var(--butter);font-size:clamp(48px,8vw,108px);margin-left:auto;margin-right:auto;max-width:820px}.rr-footer__grid{border-top:1px solid rgba(244,236,216,.18);display:grid;gap:42px;grid-template-columns:1.3fr 1fr 1fr;margin-top:70px;padding-top:44px}.rr-footer__logo{height:auto;max-width:175px;object-fit:contain}.rr-footer .rr-eyebrow{color:var(--sage)}.rr-footer__links{display:grid;gap:12px;margin-top:18px}.rr-footer__links a,.rr-footer__links p{color:rgba(244,236,216,.8);font-size:14px;font-weight:300;line-height:1.55;margin:0}.rr-legal{border-top:1px solid rgba(244,236,216,.18);color:rgba(244,236,216,.55);font-size:12.5px;margin-top:54px;padding-top:24px}@media(max-width:900px){.rr-footer{padding-left:22px!important;padding-right:22px!important}.rr-footer__grid{grid-template-columns:1fr}}</style>
{% schema %}
{"name":"RR footer","settings":[{"type":"color","id":"background","label":"Background","default":"#24482d"},{"type":"range","id":"padding","label":"Top spacing","min":60,"max":180,"step":4,"unit":"px","default":110},{"type":"range","id":"side_padding","label":"Side spacing","min":0,"max":100,"step":2,"unit":"px","default":42},{"type":"text","id":"heading","label":"Heading","default":"Let's find the root of your story."},{"type":"text","id":"cta_label","label":"Button label","default":"START AN INQUIRY"},{"type":"url","id":"cta_link","label":"Button link"},{"type":"text","id":"logo_alt","label":"Logo alt text","default":"Root & Route"},{"type":"text","id":"studio_heading","label":"Studio heading","default":"STUDIO"},{"type":"link_list","id":"menu","label":"Footer menu"},{"type":"text","id":"link_1","label":"Fallback link 1","default":"Collections"},{"type":"text","id":"link_2","label":"Fallback link 2","default":"Services"},{"type":"text","id":"link_3","label":"Fallback link 3","default":"Process"},{"type":"text","id":"contact_heading","label":"Contact heading","default":"CONTACT"},{"type":"text","id":"email","label":"Email","default":"hello@rootandroute.ca"},{"type":"text","id":"location","label":"Location","default":"Vancouver, Canada"},{"type":"text","id":"legal","label":"Legal line","default":"© 2026 Root & Route Creations Inc. · Designed in Canada · Crafted with our partner atelier"}],"presets":[{"name":"RR footer"}]}
{% endschema %}
