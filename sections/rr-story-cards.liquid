<section class="rr-story" style="background:{{ section.settings.background }};padding:{{ section.settings.padding }}px 40px"><div class="rr-wrap"><div class="rr-reveal rr-section-copy"><div class="rr-eyebrow">{{ section.settings.eyebrow }}</div><h2 class="rr-heading">{{ section.settings.heading }}</h2><div class="rr-story__lead">{{ section.settings.lead }}</div></div><div class="rr-story__grid">{%- for block in section.blocks -%}<article class="rr-story__card rr-reveal{% if block.settings.dark %} is-dark{% endif %}" {{ block.shopify_attributes }}><div class="rr-story__label"><img src="{{ 'rr-logo-mark' | append: block.settings.mark_variant | append: '.svg' | asset_url }}" alt=""><span>{{ block.settings.label }}</span></div><div class="rr-body">{{ block.settings.text }}</div></article>{%- endfor -%}</div></div></section>
<style>.rr-story{border-top:1px solid var(--line)}.rr-section-copy{max-width:760px}.rr-story__lead{color:var(--muted);font:300 19px/1.65 Jost,sans-serif;margin-top:24px}.rr-story__grid{display:grid;gap:32px;grid-template-columns:repeat(2,minmax(0,1fr));margin-top:64px}.rr-story__card{background:var(--paper);border:1px solid var(--line);border-radius:6px;padding:44px}.rr-story__card.is-dark{background:var(--forest);border-color:var(--forest)}.rr-story__label{align-items:center;color:var(--forest);display:flex;font:600 22px/1 Comfortaa,sans-serif;gap:12px}.rr-story__label img{height:26px;width:26px}.rr-story__card.is-dark .rr-story__label{color:var(--sage)}.rr-story__card.is-dark .rr-body{color:var(--butter)}@media(max-width:700px){.rr-story{padding:72px 20px!important}.rr-story__grid{grid-template-columns:1fr;margin-top:44px}.rr-story__card{padding:28px}}</style>
{% schema %}
{"name":"RR story cards","settings":[{"type":"color","id":"background","label":"Background","default":"#ffffff"},{"type":"range","id":"padding","label":"Section spacing","min":60,"max":180,"step":4,"unit":"px","default":120},{"type":"text","id":"eyebrow","label":"Eyebrow","default":"Our Story"},{"type":"text","id":"heading","label":"Heading","default":"From brand roots to market routes"},{"type":"richtext","id":"lead","label":"Lead","default":"<p>We uncover the root of every brand and create the route that brings its ideas to life.</p>"}],"blocks":[{"type":"card","name":"Story card","settings":[{"type":"text","id":"label","label":"Label","default":"ROOT"},{"type":"richtext","id":"text","label":"Text","default":"<p>We start with the root of every project — the brand, product, story, and experience it wants to create.</p>"},{"type":"checkbox","id":"dark","label":"Dark card","default":false},{"type":"select","id":"mark_variant","label":"Mark color","options":[{"value":"","label":"Forest"},{"value":"-leaf","label":"Leaf"},{"value":"-cream","label":"Cream"}],"default":""}]}],"presets":[{"name":"RR story cards","blocks":[{"type":"card"},{"type":"card","settings":{"label":"ROUTE","dark":true,"mark_variant":"-leaf"}}]}]}
{% endschema %}
