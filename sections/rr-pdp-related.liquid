{%- liquid
  case section.settings.image_ratio
    when 'square'
      assign image_ratio = '1 / 1'
    when 'landscape'
      assign image_ratio = '4 / 3'
    when 'portrait_tall'
      assign image_ratio = '2 / 3'
    else
      assign image_ratio = '4 / 5'
  endcase
-%}

<section
  class="rr-pdp-component rr-pdp-related"
  style="
    --rr-pdp-background: {{ section.settings.background }};
    --rr-pdp-text: {{ section.settings.text_color }};
    --rr-pdp-muted: {{ section.settings.muted_color }};
    --rr-pdp-accent: {{ section.settings.accent }};
    --rr-pdp-line: {{ section.settings.border_color }};
    --rr-pdp-image-background: {{ section.settings.image_background }};
    --rr-pdp-image-ratio: {{ image_ratio }};
    --rr-pdp-image-fit: {{ section.settings.image_fit }};
    --rr-pdp-max-width: {{ section.settings.max_width }}px;
    --rr-pdp-padding-top: {{ section.settings.padding_top }}px;
    --rr-pdp-padding-bottom: {{ section.settings.padding_bottom }}px;
    --rr-pdp-columns: {{ section.settings.columns }};
    --rr-pdp-card-gap: {{ section.settings.card_gap }}px;
    --rr-pdp-heading-size: {{ section.settings.heading_size }}px;
    --rr-pdp-subheading-size: {{ section.settings.subheading_size }}px;
    --rr-pdp-body-size: {{ section.settings.body_size }}px;
  "
>
  <div class="rr-pdp-component__inner">
    <header class="rr-pdp-related__heading">
      <div>
        {%- if section.settings.eyebrow != blank -%}<p class="rr-pdp-component__eyebrow">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
        {%- if section.settings.heading != blank -%}<h2>{{ section.settings.heading | escape }}</h2>{%- endif -%}
      </div>
      {%- if section.settings.link_label != blank -%}
        <a class="rr-pdp-related__view-all" href="{{ section.settings.link | default: routes.collections_url }}">{{ section.settings.link_label | escape }} <span aria-hidden="true">→</span></a>
      {%- endif -%}
    </header>

    <div class="rr-pdp-related__grid">
      {%- for block in section.blocks -%}
        {%- liquid
          assign card_product = block.settings.product
          assign card_url = block.settings.link
          if card_url == blank and card_product != blank
            assign card_url = card_product.url
          endif
          if card_url == blank
            assign card_url = routes.collections_url
          endif
          assign card_image = block.settings.image | default: card_product.featured_image
          assign card_title = block.settings.title | default: card_product.title
          assign card_alt = card_image.alt | default: card_title
        -%}
        <article class="rr-pdp-related__card" {{ block.shopify_attributes }}>
          <a class="rr-pdp-related__image" href="{{ card_url }}">
            {%- if card_image != blank -%}
              {{ card_image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '360, 540, 720, 900', sizes: '(min-width: 990px) 30vw, 100vw', alt: card_alt }}
            {%- else -%}
              {{ 'product-1' | placeholder_svg_tag }}
            {%- endif -%}
          </a>
          <div class="rr-pdp-related__copy">
            {%- if block.settings.eyebrow != blank -%}<p class="rr-pdp-component__eyebrow">{{ block.settings.eyebrow | escape }}</p>{%- endif -%}
            <h3><a href="{{ card_url }}">{{ card_title | default: 'Signature collection' | escape }}</a></h3>
            {%- if block.settings.text != blank -%}<p>{{ block.settings.text | escape }}</p>{%- endif -%}
          </div>
        </article>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "RR PDP - Related",
  "max_blocks": 4,
  "enabled_on": { "templates": ["product"] },
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Continue exploring" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Related collections" },
    { "type": "text", "id": "link_label", "label": "View all label", "default": "View all collections" },
    { "type": "url", "id": "link", "label": "View all link" },
    { "type": "header", "content": "Cards" },
    { "type": "range", "id": "columns", "label": "Desktop columns", "min": 2, "max": 4, "step": 1, "default": 3 },
    { "type": "range", "id": "card_gap", "label": "Card gap", "min": 8, "max": 48, "step": 2, "unit": "px", "default": 22 },
    { "type": "select", "id": "image_ratio", "label": "Image aspect ratio", "options": [
      { "value": "portrait", "label": "Portrait 4:5" },
      { "value": "portrait_tall", "label": "Portrait 2:3" },
      { "value": "square", "label": "Square" },
      { "value": "landscape", "label": "Landscape 4:3" }
    ], "default": "portrait" },
    { "type": "select", "id": "image_fit", "label": "Image fit", "options": [
      { "value": "cover", "label": "Cover" },
      { "value": "contain", "label": "Contain" }
    ], "default": "cover" },
    { "type": "header", "content": "Typography" },
    { "type": "range", "id": "heading_size", "label": "Heading size", "min": 28, "max": 72, "step": 1, "unit": "px", "default": 52 },
    { "type": "range", "id": "subheading_size", "label": "Card heading size", "min": 16, "max": 40, "step": 1, "unit": "px", "default": 24 },
    { "type": "range", "id": "body_size", "label": "Body size", "min": 12, "max": 24, "step": 1, "unit": "px", "default": 16 },
    { "type": "header", "content": "Layout" },
    { "type": "range", "id": "max_width", "label": "Maximum width", "min": 960, "max": 1600, "step": 20, "unit": "px", "default": 1360 },
    { "type": "range", "id": "padding_top", "label": "Top spacing", "min": 0, "max": 180, "step": 4, "unit": "px", "default": 96 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom spacing", "min": 0, "max": 180, "step": 4, "unit": "px", "default": 96 },
    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "background", "label": "Background", "default": "#fafaf8" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#141414" },
    { "type": "color", "id": "muted_color", "label": "Muted text", "default": "#6b6b63" },
    { "type": "color", "id": "accent", "label": "Accent", "default": "#2f5e3a" },
    { "type": "color", "id": "border_color", "label": "Lines", "default": "#ecebe6" },
    { "type": "color", "id": "image_background", "label": "Image background", "default": "#efeae0" }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Related card",
      "settings": [
        { "type": "product", "id": "product", "label": "Product" },
        { "type": "image_picker", "id": "image", "label": "Custom image", "info": "Overrides the selected product image." },
        { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Custom packaging" },
        { "type": "text", "id": "title", "label": "Custom title", "info": "Leave blank to use the selected product title." },
        { "type": "textarea", "id": "text", "label": "Short description" },
        { "type": "url", "id": "link", "label": "Custom link", "info": "Overrides the selected product link." }
      ]
    }
  ],
  "presets": [
    {
      "name": "RR PDP - Related",
      "blocks": [
        { "type": "card", "settings": { "title": "Signature rigid boxes", "text": "A considered format with a precise, tactile reveal." } },
        { "type": "card", "settings": { "title": "Advent collections", "text": "Interactive structures made for seasonal storytelling." } },
        { "type": "card", "settings": { "title": "Coordinated gift suites", "text": "Matched packaging elements designed as one visual system." } }
      ]
    }
  ]
}
{% endschema %}
