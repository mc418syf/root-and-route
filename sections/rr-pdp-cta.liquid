<section
  class="rr-pdp-component rr-pdp-cta"
  style="
    --rr-pdp-background: {{ section.settings.background }};
    --rr-pdp-text: {{ section.settings.text_color }};
    --rr-pdp-muted: {{ section.settings.muted_color }};
    --rr-pdp-accent: {{ section.settings.accent }};
    --rr-pdp-button-background: {{ section.settings.button_background }};
    --rr-pdp-button-text: {{ section.settings.button_text }};
    --rr-pdp-button-radius: {{ section.settings.button_radius }}px;
    --rr-pdp-max-width: {{ section.settings.max_width }}px;
    --rr-pdp-content-width: {{ section.settings.content_width }}px;
    --rr-pdp-padding-top: {{ section.settings.padding_top }}px;
    --rr-pdp-padding-bottom: {{ section.settings.padding_bottom }}px;
    --rr-pdp-heading-size: {{ section.settings.heading_size }}px;
    --rr-pdp-body-size: {{ section.settings.body_size }}px;
    --rr-pdp-text-align: {{ section.settings.alignment }};
  "
>
  <div class="rr-pdp-component__inner">
    <div class="rr-pdp-cta__inner">
      {%- if section.settings.eyebrow != blank -%}<p class="rr-pdp-component__eyebrow">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
      {%- if section.settings.heading != blank -%}<h2>{{ section.settings.heading | escape }}</h2>{%- endif -%}
      {%- if section.settings.text != blank -%}<div class="rte">{{ section.settings.text }}</div>{%- endif -%}
      {%- if section.settings.button_label != blank -%}
        <a class="rr-pdp-cta__button" href="{{ section.settings.button_link | default: '/pages/contact' }}">
          {{ section.settings.button_label | escape }}
          {%- if section.settings.show_arrow -%}<span aria-hidden="true">→</span>{%- endif -%}
        </a>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "RR PDP - Closing CTA",
  "enabled_on": { "templates": ["product"] },
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Start a conversation" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Have a project in mind?" },
    { "type": "richtext", "id": "text", "label": "Description", "default": "<p>Share your product, target volume, and timeline. We will shape the right route to production.</p>" },
    { "type": "text_alignment", "id": "alignment", "label": "Alignment", "default": "center" },
    { "type": "header", "content": "Button" },
    { "type": "text", "id": "button_label", "label": "Label", "default": "Request a quote" },
    { "type": "url", "id": "button_link", "label": "Link" },
    { "type": "checkbox", "id": "show_arrow", "label": "Show arrow", "default": true },
    { "type": "range", "id": "button_radius", "label": "Corner radius", "min": 0, "max": 40, "step": 1, "unit": "px", "default": 2 },
    { "type": "header", "content": "Typography" },
    { "type": "range", "id": "heading_size", "label": "Heading size", "min": 28, "max": 72, "step": 1, "unit": "px", "default": 52 },
    { "type": "range", "id": "body_size", "label": "Body size", "min": 12, "max": 24, "step": 1, "unit": "px", "default": 17 },
    { "type": "header", "content": "Layout" },
    { "type": "range", "id": "max_width", "label": "Maximum width", "min": 960, "max": 1600, "step": 20, "unit": "px", "default": 1360 },
    { "type": "range", "id": "content_width", "label": "Text width", "min": 400, "max": 1000, "step": 20, "unit": "px", "default": 760 },
    { "type": "range", "id": "padding_top", "label": "Top spacing", "min": 0, "max": 180, "step": 4, "unit": "px", "default": 104 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom spacing", "min": 0, "max": 180, "step": 4, "unit": "px", "default": 104 },
    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "background", "label": "Background", "default": "#f4ecd8" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#141414" },
    { "type": "color", "id": "muted_color", "label": "Muted text", "default": "#6b6b63" },
    { "type": "color", "id": "accent", "label": "Eyebrow", "default": "#2f5e3a" },
    { "type": "color", "id": "button_background", "label": "Button background", "default": "#2f5e3a" },
    { "type": "color", "id": "button_text", "label": "Button text", "default": "#fafaf8" }
  ],
  "presets": [
    { "name": "RR PDP - Closing CTA" }
  ]
}
{% endschema %}
