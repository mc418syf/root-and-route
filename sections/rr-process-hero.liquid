<section
  id="RRProcessHero-{{ section.id }}"
  class="rr-process-hero"
  style="
    --rr-process-bg: {{ section.settings.background }};
    --rr-process-ink: {{ section.settings.text_color }};
    --rr-process-muted: {{ section.settings.muted_color }};
    --rr-process-accent: {{ section.settings.accent }};
    --rr-process-button-text: {{ section.settings.button_text }};
    --rr-process-max: {{ section.settings.max_width }}px;
    --rr-process-top: {{ section.settings.padding_top }}px;
    --rr-process-bottom: {{ section.settings.padding_bottom }}px;
    --rr-process-side: {{ section.settings.side_padding }}px;
    --rr-process-heading-size: {{ section.settings.heading_size }}px;
  "
  aria-labelledby="RRProcessHeroHeading-{{ section.id }}"
>
  <div class="rr-process-hero__inner">
    {%- if section.settings.eyebrow != blank -%}
      <p class="rr-process-hero__eyebrow">{{ section.settings.eyebrow | escape }}</p>
    {%- endif -%}
    <h1 id="RRProcessHeroHeading-{{ section.id }}">{{ section.settings.heading | escape }}</h1>
    {%- if section.settings.text != blank -%}
      <div class="rr-process-hero__text">{{ section.settings.text }}</div>
    {%- endif -%}
    {%- if section.blocks.size > 0 -%}
      <div class="rr-process-hero__actions">
        {%- for block in section.blocks -%}
          <a
            class="rr-process-hero__button{% if block.settings.secondary %} rr-process-hero__button--secondary{% endif %}"
            href="{{ block.settings.link | default: '#RRProcessStages' }}"
            {{ block.shopify_attributes }}
          >
            {{ block.settings.label | escape }}
            {%- unless block.settings.secondary -%}<span aria-hidden="true">→</span>{%- endunless -%}
          </a>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</section>

{% stylesheet %}
  .rr-process-hero {
    background: var(--rr-process-bg);
    color: var(--rr-process-ink);
    font-family: var(--font-body--family);
    padding: var(--rr-process-top) var(--rr-process-side) var(--rr-process-bottom);
  }

  .rr-process-hero * {
    box-sizing: border-box;
  }

  .rr-process-hero__inner {
    margin: 0 auto;
    max-width: var(--rr-process-max);
    text-align: center;
  }

  .rr-process-hero__eyebrow {
    color: var(--rr-process-accent);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0;
    line-height: 1.3;
    margin: 0;
    text-transform: uppercase;
  }

  .rr-process-hero h1 {
    font-family: var(--font-heading--family);
    font-size: var(--rr-process-heading-size);
    font-weight: 400;
    letter-spacing: 0;
    line-height: 1.04;
    margin: 22px auto 0;
    max-width: 20ch;
  }

  .rr-process-hero__text {
    color: var(--rr-process-muted);
    font-size: 20px;
    font-weight: 300;
    line-height: 1.6;
    margin: 24px auto 0;
    max-width: 52ch;
  }

  .rr-process-hero__text p {
    margin: 0;
  }

  .rr-process-hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    justify-content: center;
    margin-top: 40px;
  }

  .rr-process-hero__button {
    align-items: center;
    background: var(--rr-process-accent);
    border: 1px solid var(--rr-process-accent);
    border-radius: 2px;
    color: var(--rr-process-button-text);
    display: inline-flex;
    font-size: 12px;
    font-weight: 500;
    gap: 12px;
    justify-content: center;
    letter-spacing: 0;
    min-height: 48px;
    padding: 14px 24px;
    text-decoration: none;
    text-transform: uppercase;
    transition: background-color 180ms ease, color 180ms ease;
  }

  .rr-process-hero__button:hover {
    background: #24482d;
    color: var(--rr-process-button-text);
  }

  .rr-process-hero__button--secondary {
    background: transparent;
    border-color: var(--rr-process-ink);
    color: var(--rr-process-ink);
  }

  .rr-process-hero__button--secondary:hover {
    background: var(--rr-process-ink);
    color: var(--rr-process-bg);
  }

  @media screen and (max-width: 989px) {
    .rr-process-hero h1 {
      font-size: 54px;
    }
  }

  @media screen and (max-width: 749px) {
    .rr-process-hero {
      padding-left: 20px;
      padding-right: 20px;
    }

    .rr-process-hero h1 {
      font-size: 42px;
    }

    .rr-process-hero__text {
      font-size: 18px;
    }

    .rr-process-hero__actions {
      display: grid;
    }

    .rr-process-hero__button {
      width: 100%;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "RR process hero",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Custom Packaging" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Our production process" },
    { "type": "richtext", "id": "text", "label": "Introduction", "default": "<p>Precision in every step. Excellence in every detail - eight stages between your dieline and a box in your customer's hands.</p>" },
    { "type": "range", "id": "heading_size", "label": "Desktop heading size", "min": 44, "max": 88, "step": 2, "unit": "px", "default": 72 },
    { "type": "range", "id": "max_width", "label": "Content width", "min": 960, "max": 1600, "step": 20, "unit": "px", "default": 1360 },
    { "type": "range", "id": "padding_top", "label": "Top spacing", "min": 0, "max": 180, "step": 4, "unit": "px", "default": 96 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom spacing", "min": 0, "max": 180, "step": 4, "unit": "px", "default": 72 },
    { "type": "range", "id": "side_padding", "label": "Desktop side spacing", "min": 0, "max": 80, "step": 4, "unit": "px", "default": 40 },
    { "type": "color", "id": "background", "label": "Background", "default": "#fafaf8" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#141414" },
    { "type": "color", "id": "muted_color", "label": "Body text", "default": "#6b6b63" },
    { "type": "color", "id": "accent", "label": "Accent", "default": "#2f5e3a" },
    { "type": "color", "id": "button_text", "label": "Primary button text", "default": "#f4ecd8" }
  ],
  "blocks": [
    {
      "type": "button",
      "name": "Button",
      "limit": 2,
      "settings": [
        { "type": "text", "id": "label", "label": "Label", "default": "See the eight stages" },
        { "type": "url", "id": "link", "label": "Link" },
        { "type": "checkbox", "id": "secondary", "label": "Secondary style", "default": false }
      ]
    }
  ],
  "presets": [
    {
      "name": "RR process hero",
      "blocks": [
        { "type": "button" },
        { "type": "button", "settings": { "label": "Order a sample kit", "secondary": true } }
      ]
    }
  ]
}
{% endschema %}
