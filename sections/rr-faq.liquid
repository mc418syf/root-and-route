<section class="rr-faq" id="questions" style="background:{{ section.settings.background }};padding:{{ section.settings.padding }}px 40px"><div class="rr-wrap rr-faq__layout"><div class="rr-reveal"><div class="rr-eyebrow">{{ section.settings.eyebrow }}</div><h2 class="rr-heading">{{ section.settings.heading }}</h2><div class="rr-body">{{ section.settings.text }}</div>{%- if section.settings.cta_label != blank -%}<a class="rr-link" href="{{ section.settings.cta_link }}" style="display:inline-block;margin-top:30px">{{ section.settings.cta_label }}</a>{%- endif -%}</div><div class="rr-faq__items rr-reveal">{%- for block in section.blocks -%}<details class="rr-faq__item"{% if forloop.first and section.settings.open_first %} open{% endif %} {{ block.shopify_attributes }}><summary><span>{{ block.settings.question }}</span><span class="rr-faq__icon" aria-hidden="true"></span></summary><div class="rr-faq__answer">{{ block.settings.answer }}</div></details>{%- endfor -%}</div></div></section>
<style>.rr-faq{border-top:1px solid var(--line)}.rr-faq__layout{display:grid;gap:clamp(60px,8vw,120px);grid-template-columns:.75fr 1.25fr}.rr-faq__items{border-top:1px solid var(--line)}.rr-faq__item{border-bottom:1px solid var(--line)}.rr-faq__item summary{align-items:center;color:var(--ink);cursor:pointer;display:flex;font:500 20px/1.4 Comfortaa,sans-serif;gap:24px;justify-content:space-between;list-style:none;padding:28px 0}.rr-faq__item summary::-webkit-details-marker{display:none}.rr-faq__icon{height:18px;position:relative;flex:0 0 18px}.rr-faq__icon:before,.rr-faq__icon:after{background:var(--forest);content:"";height:1.5px;left:0;position:absolute;top:8px;width:18px}.rr-faq__icon:after{transform:rotate(90deg);transition:transform .25s ease}.rr-faq__item[open] .rr-faq__icon:after{transform:rotate(0)}.rr-faq__answer{color:var(--muted);font:300 16px/1.7 Jost,sans-serif;max-width:720px;padding:0 48px 30px 0}.rr-faq__answer p{margin:0 0 14px}@media(max-width:800px){.rr-faq{padding-left:28px!important;padding-right:28px!important}.rr-faq__layout{grid-template-columns:1fr}}@media(max-width:600px){.rr-faq{padding:72px 20px!important}.rr-faq__item summary{font-size:17px;padding:22px 0}}</style>
{% schema %}
{"name":"RR Q&A accordion","settings":[{"type":"color","id":"background","label":"Background","default":"#fafaf8"},{"type":"range","id":"padding","label":"Section spacing","min":20,"max":180,"step":4,"unit":"px","default":120},{"type":"text","id":"eyebrow","label":"Eyebrow","default":"Questions & Answers"},{"type":"text","id":"heading","label":"Heading","default":"What brands ask before we begin"},{"type":"richtext","id":"text","label":"Introduction","default":"<p>Clear answers about custom structures, quantities, timing, materials, and production.</p>"},{"type":"checkbox","id":"open_first","label":"Open first question","default":true},{"type":"text","id":"cta_label","label":"Contact link label","default":"ASK A DIFFERENT QUESTION →"},{"type":"url","id":"cta_link","label":"Contact link"}],"blocks":[{"type":"question","name":"Question","settings":[{"type":"text","id":"question","label":"Question","default":"What is the minimum order quantity?"},{"type":"richtext","id":"answer","label":"Answer","default":"<p>Minimums depend on structure, materials, finishing, and production method. Share your target quantity and we will recommend the most practical route.</p>"}]}],"presets":[{"name":"RR Q&A accordion","blocks":[{"type":"question"},{"type":"question","settings":{"question":"How long does a custom packaging project take?","answer":"<p>Most projects move through briefing, structural development, sampling, approval, production, and freight. Timing depends on complexity and destination, and we establish the schedule before work begins.</p>"}},{"type":"question","settings":{"question":"Can you work from an existing dieline or design?","answer":"<p>Yes. We can produce from approved artwork and dielines, refine an existing structure, or develop the packaging system with you from the beginning.</p>"}},{"type":"question","settings":{"question":"Do you offer sustainable materials?","answer":"<p>Yes. We source FSC-certified paperboards, specialty papers, and lower-impact material options based on the structural and visual requirements of the project.</p>"}}]}]}
{% endschema %}
