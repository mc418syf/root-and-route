<section class="rr-page-hero" style="background:{{ section.settings.background }};padding:{{ section.settings.padding_top }}px 40px {{ section.settings.padding_bottom }}px"><div class="rr-wrap"><div class="rr-reveal" style="max-width:1000px"><div class="rr-eyebrow">{{ section.settings.eyebrow }}</div><h1>{{ section.settings.heading }}</h1><div class="rr-page-hero__lead">{{ section.settings.text }}</div></div>{%- if section.settings.show_images -%}<div class="rr-page-hero__media rr-reveal"><div class="rr-page-hero__main">{%- if section.settings.image != blank -%}{{ section.settings.image | image_url:width:1800 | image_tag:loading:'eager',sizes:'100vw',alt:section.settings.image_alt }}{%- else -%}<span>{{ section.settings.placeholder_1 }}</span>{%- endif -%}</div><div class="rr-page-hero__side"><div>{%- if section.settings.image_2 != blank -%}{{ section.settings.image_2 | image_url:width:900 | image_tag:loading:'lazy',alt:section.settings.image_alt }}{%- else -%}<span>{{ section.settings.placeholder_2 }}</span>{%- endif -%}</div><div>{%- if section.settings.image_3 != blank -%}{{ section.settings.image_3 | image_url:width:900 | image_tag:loading:'lazy',alt:section.settings.image_alt }}{%- else -%}<span>{{ section.settings.placeholder_3 }}</span>{%- endif -%}</div></div></div>{%- endif -%}</div></section>
<style>.rr-page-hero h1{color:var(--ink);font:500 clamp(40px,5.6vw,76px)/1.06 Comfortaa,Jost,sans-serif;letter-spacing:0;margin:28px 0 0;max-width:1000px}.rr-page-hero__lead{color:var(--muted);font:300 19px/1.65 Jost,sans-serif;margin-top:28px;max-width:640px}.rr-page-hero__lead p{margin:0}.rr-page-hero__media{display:grid;grid-template-columns:1.6fr 1fr;gap:16px;margin-top:44px;align-items:end}.rr-page-hero__main,.rr-page-hero__side>div{align-items:center;background:var(--warm);border-radius:3px;color:#8a8a82;display:flex;font:400 12px/1.5 Jost,sans-serif;height:440px;justify-content:center;letter-spacing:.14em;overflow:hidden;padding:24px;text-align:center;text-transform:uppercase}.rr-page-hero__side{display:grid;gap:16px}.rr-page-hero__side>div{height:212px}@media(max-width:900px){.rr-page-hero{padding-left:28px!important;padding-right:28px!important}.rr-page-hero__media{grid-template-columns:1fr}.rr-page-hero__side{grid-template-columns:1fr 1fr}}@media(max-width:600px){.rr-page-hero{padding:72px 20px 56px!important}.rr-page-hero__main{height:330px}.rr-page-hero__side{display:none}}</style>
{% schema %}
{"name":"RR page hero","settings":[{"type":"color","id":"background","label":"Background","default":"#fafaf8"},{"type":"range","id":"padding_top","label":"Top spacing","min":48,"max":180,"step":4,"unit":"px","default":112},{"type":"range","id":"padding_bottom","label":"Bottom spacing","min":40,"max":140,"step":4,"unit":"px","default":72},{"type":"text","id":"eyebrow","label":"Eyebrow","default":"About · Root & Route Creations"},{"type":"text","id":"heading","label":"Heading","default":"Packaging, rooted in your brand. Built for the way you grow."},{"type":"richtext","id":"text","label":"Introduction","default":"<p>Root & Route Creations is a North American packaging partner helping brands turn ideas into thoughtfully engineered, production-ready packaging.</p>"},{"type":"checkbox","id":"show_images","label":"Show image composition","default":true},{"type":"image_picker","id":"image","label":"Main image"},{"type":"image_picker","id":"image_2","label":"Side image 1"},{"type":"image_picker","id":"image_3","label":"Side image 2"},{"type":"text","id":"image_alt","label":"Image alt text","default":"Root & Route packaging studio"},{"type":"text","id":"placeholder_1","label":"Main placeholder label","default":"Studio / atelier photography"},{"type":"text","id":"placeholder_2","label":"Side placeholder 1","default":"Dieline / prototype"},{"type":"text","id":"placeholder_3","label":"Side placeholder 2","default":"Material detail"}],"presets":[{"name":"RR page hero"}]}
{% endschema %}
