<section class="rr-numbered" style="background:{{ section.settings.background }};padding:{{ section.settings.padding }}px 40px"><div class="rr-wrap"><div class="rr-reveal rr-section-copy"><div class="rr-eyebrow">{{ section.settings.eyebrow }}</div><h2 class="rr-heading">{{ section.settings.heading }}</h2>{%- if section.settings.text != blank -%}<div class="rr-body">{{ section.settings.text }}</div>{%- endif -%}</div><div class="rr-numbered__grid" style="--rr-cols:{{ section.settings.columns }}">{%- for block in section.blocks -%}<article class="rr-numbered__item rr-reveal" {{ block.shopify_attributes }}><div class="rr-numbered__number">{{ block.settings.number }}</div><h3>{{ block.settings.title }}</h3><div class="rr-body">{{ block.settings.text }}</div></article>{%- endfor -%}</div></div></section>
<style>.rr-numbered{border-top:1px solid var(--line)}.rr-numbered__grid{display:grid;gap:28px;grid-template-columns:repeat(var(--rr-cols),minmax(0,1fr));margin-top:64px}.rr-numbered__item{border-top:1px solid var(--line);padding-top:22px}.rr-numbered__number{color:var(--forest);font:400 22px/1 Comfortaa,sans-serif}.rr-numbered h3{color:var(--ink);font:600 20px/1.3 Comfortaa,sans-serif;margin:14px 0 0}.rr-numbered .rr-body{margin-top:12px}@media(max-width:1000px){.rr-numbered__grid{grid-template-columns:repeat(2,minmax(0,1fr))}}@media(max-width:600px){.rr-numbered{padding:72px 20px!important}.rr-numbered__grid{grid-template-columns:1fr;margin-top:44px}}</style>
{% schema %}
{"name":"RR numbered grid","settings":[{"type":"color","id":"background","label":"Background","default":"#fafaf8"},{"type":"range","id":"padding","label":"Section spacing","min":60,"max":180,"step":4,"unit":"px","default":120},{"type":"range","id":"columns","label":"Desktop columns","min":2,"max":5,"step":1,"default":5},{"type":"text","id":"eyebrow","label":"Eyebrow","default":"What We Do"},{"type":"text","id":"heading","label":"Heading","default":"Your North American packaging partner — from first idea to final box"},{"type":"richtext","id":"text","label":"Optional introduction"}],"blocks":[{"type":"item","name":"Numbered item","settings":[{"type":"text","id":"number","label":"Number","default":"01"},{"type":"text","id":"title","label":"Title","default":"Discover"},{"type":"richtext","id":"text","label":"Text","default":"<p>Understand your product, brand, audience, budget and goals.</p>"}]}],"presets":[{"name":"RR numbered grid","blocks":[{"type":"item"},{"type":"item"},{"type":"item"}]}]}
{% endschema %}
