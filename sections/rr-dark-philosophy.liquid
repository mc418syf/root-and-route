<section class="rr-dark-philosophy" style="background:{{ section.settings.background }};padding:{{ section.settings.padding }}px 40px"><div class="rr-wrap rr-dark-philosophy__grid"><div class="rr-reveal"><div class="rr-eyebrow" style="color:var(--sage)">{{ section.settings.eyebrow }}</div><h2>{{ section.settings.heading }}</h2><div class="rr-dark-philosophy__text">{{ section.settings.text }}</div><div class="rr-dark-philosophy__quote">{{ section.settings.pullquote }}</div></div>{%- if section.settings.show_images -%}<div class="rr-dark-philosophy__images rr-reveal">{%- for block in section.blocks -%}<div class="rr-dark-philosophy__tile" {{ block.shopify_attributes }}>{%- if block.settings.image != blank -%}{{ block.settings.image | image_url:width:900 | image_tag:loading:'lazy',alt:block.settings.label }}{%- else -%}<span>{{ block.settings.label }}</span>{%- endif -%}</div>{%- endfor -%}</div>{%- endif -%}</div></section>
<style>.rr-dark-philosophy__grid{align-items:center;display:grid;gap:80px;grid-template-columns:1fr 1.15fr}.rr-dark-philosophy h2{color:var(--butter);font:500 clamp(30px,4vw,52px)/1.12 Comfortaa,sans-serif;margin:28px 0 0}.rr-dark-philosophy__text{color:rgba(244,236,216,.82);font:300 17px/1.7 Jost,sans-serif;margin-top:28px}.rr-dark-philosophy__text p{margin:0 0 18px}.rr-dark-philosophy__quote{color:var(--sage);font:400 20px/1.5 Comfortaa,sans-serif;margin-top:24px}.rr-dark-philosophy__images{display:grid;gap:16px;grid-template-columns:1fr 1fr}.rr-dark-philosophy__tile{align-items:center;background:rgba(244,236,216,.08);border:1px solid rgba(244,236,216,.2);border-radius:3px;color:rgba(244,236,216,.5);display:flex;font:400 12px/1.5 Jost,sans-serif;height:230px;justify-content:center;letter-spacing:.14em;overflow:hidden;padding:16px;text-align:center;text-transform:uppercase}.rr-dark-philosophy__tile:nth-child(2){transform:translateY(32px)}.rr-dark-philosophy__tile:nth-child(3){transform:translateY(-32px)}@media(max-width:900px){.rr-dark-philosophy{padding-left:28px!important;padding-right:28px!important}.rr-dark-philosophy__grid{grid-template-columns:1fr}.rr-dark-philosophy__tile{transform:none!important}}@media(max-width:600px){.rr-dark-philosophy{padding:72px 20px!important}.rr-dark-philosophy__tile{height:160px}}</style>
{% schema %}
{"name":"RR dark philosophy","settings":[{"type":"color","id":"background","label":"Background","default":"#24482d"},{"type":"range","id":"padding","label":"Section spacing","min":20,"max":180,"step":4,"unit":"px","default":120},{"type":"text","id":"eyebrow","label":"Eyebrow","default":"Our Philosophy"},{"type":"text","id":"heading","label":"Heading","default":"A box could be anything"},{"type":"richtext","id":"text","label":"Text","default":"<p>Custom packaging gives brands room to create. A box can open differently, transform into something unexpected, or become part of the product experience.</p><p>Bring us a sketch, reference, unusual concept, or an idea you're not sure can be made.</p>"},{"type":"text","id":"pullquote","label":"Pullquote","default":"Some of the best packaging starts with an idea that sounds a little impossible."},{"type":"checkbox","id":"show_images","label":"Show image grid","default":true}],"blocks":[{"type":"image","name":"Image tile","settings":[{"type":"image_picker","id":"image","label":"Image"},{"type":"text","id":"label","label":"Placeholder label","default":"Packaging detail"}]}],"presets":[{"name":"RR dark philosophy","blocks":[{"type":"image"},{"type":"image"},{"type":"image"},{"type":"image"}]}]}
{% endschema %}
