{%- liquid
  assign metafield_namespace = section.settings.metafield_namespace | strip
  assign metafield_key = section.settings.metafield_key | strip
  assign audience_metafield = product.metafields[metafield_namespace][metafield_key]
  assign audience_values = audience_metafield.value
  assign audience_value_count = 0

  if audience_metafield != blank and audience_metafield.type contains 'list.'
    assign audience_value_count = audience_values | size
  endif

  assign render_metafield = false
  assign render_manual_blocks = false

  case section.settings.content_source
    when 'manual'
      assign render_manual_blocks = true
    when 'metafield'
      assign render_metafield = true
    when 'combined'
      assign render_metafield = true
      assign render_manual_blocks = true
    else
      if audience_value_count > 0
        assign render_metafield = true
      else
        assign render_manual_blocks = true
      endif
  endcase
-%}

<section
  class="rr-pdp-component rr-pdp-audiences rr-pdp-audiences--{{ section.settings.desktop_layout }}"
  style="
    --rr-pdp-background: {{ section.settings.background }};
    --rr-pdp-text: {{ section.settings.text_color }};
    --rr-pdp-muted: {{ section.settings.muted_color }};
    --rr-pdp-eyebrow-color: {{ section.settings.eyebrow_color }};
    --rr-pdp-grid-line: {{ section.settings.border_color }};
    --rr-pdp-max-width: {{ section.settings.max_width }}px;
    --rr-pdp-padding-top: {{ section.settings.padding_top }}px;
    --rr-pdp-padding-bottom: {{ section.settings.padding_bottom }}px;
    --rr-pdp-column-gap: {{ section.settings.column_gap }}px;
    --rr-pdp-card-min-height: {{ section.settings.card_min_height }}px;
    --rr-pdp-card-padding: {{ section.settings.card_padding }}px;
    --rr-pdp-heading-size: {{ section.settings.heading_size }}px;
    --rr-pdp-subheading-size: {{ section.settings.subheading_size }}px;
    --rr-pdp-body-size: {{ section.settings.body_size }}px;
  "
>
  <div class="rr-pdp-component__inner rr-pdp-audiences__layout">
    <header class="rr-pdp-audiences__heading">
      {%- if section.settings.eyebrow != blank -%}<p class="rr-pdp-component__eyebrow">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
      {%- if section.settings.heading != blank -%}<h2>{{ section.settings.heading | escape }}</h2>{%- endif -%}
    </header>

    <div class="rr-pdp-audiences__grid">
      {%- if render_metafield and audience_value_count > 0 -%}
        {%- for audience_item in audience_values limit: section.settings.metafield_limit -%}
          {%- liquid
            assign item_heading = audience_item.heading.value | default: audience_item.title.value | default: audience_item.name.value | default: audience_item.label.value
            assign item_description_field = audience_item.description | default: audience_item.text | default: audience_item.details | default: audience_item.body
            assign item_description = item_description_field.value

            if item_heading == blank
              assign item_parts = audience_item | split: '|'
              assign item_heading = item_parts.first | strip
              if item_parts.size > 1
                assign item_description = item_parts.last | strip
              endif
            endif
          -%}
          {%- if item_heading != blank -%}
            <article class="rr-pdp-audiences__item">
              <h3>{{ item_heading | escape }}</h3>
              {%- if item_description_field.type == 'rich_text_field' -%}
                <div class="rte">{{ item_description_field | metafield_tag }}</div>
              {%- elsif item_description != blank -%}
                <div class="rte"><p>{{ item_description | escape | newline_to_br }}</p></div>
              {%- endif -%}
            </article>
          {%- endif -%}
        {%- endfor -%}
      {%- elsif render_metafield and request.design_mode -%}
        <div class="rr-pdp-audiences__empty">
          Add values to <strong>{{ metafield_namespace | escape }}.{{ metafield_key | escape }}</strong> on this product, or change Content source to Manual blocks.
        </div>
      {%- endif -%}

      {%- if render_manual_blocks -%}
        {%- for block in section.blocks -%}
          <article class="rr-pdp-audiences__item" {{ block.shopify_attributes }}>
            <h3>{{ block.settings.heading | escape }}</h3>
            {%- if block.settings.text != blank -%}<div class="rte">{{ block.settings.text }}</div>{%- endif -%}
          </article>
        {%- endfor -%}
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "RR PDP - Perfect for",
  "max_blocks": 8,
  "enabled_on": { "templates": ["product"] },
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Designed for impact" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Perfect for" },
    { "type": "header", "content": "Content source" },
    { "type": "select", "id": "content_source", "label": "Card source", "options": [
      { "value": "auto", "label": "Metafield with manual fallback" },
      { "value": "metafield", "label": "Metafield only" },
      { "value": "manual", "label": "Manual blocks" },
      { "value": "combined", "label": "Metafield and manual blocks" }
    ], "default": "auto" },
    { "type": "text", "id": "metafield_namespace", "label": "Metafield namespace", "default": "custom", "info": "Use a list of metaobjects or list of single-line text." },
    { "type": "text", "id": "metafield_key", "label": "Metafield key", "default": "perfect_for", "info": "For text lists, format each value as Heading | Description." },
    { "type": "range", "id": "metafield_limit", "label": "Maximum metafield cards", "min": 1, "max": 8, "step": 1, "default": 4 },
    { "type": "header", "content": "Typography" },
    { "type": "range", "id": "heading_size", "label": "Heading size", "min": 28, "max": 72, "step": 1, "unit": "px", "default": 52 },
    { "type": "range", "id": "subheading_size", "label": "Item heading size", "min": 16, "max": 40, "step": 1, "unit": "px", "default": 24 },
    { "type": "range", "id": "body_size", "label": "Body size", "min": 12, "max": 24, "step": 1, "unit": "px", "default": 15 },
    { "type": "header", "content": "Layout" },
    { "type": "select", "id": "desktop_layout", "label": "Desktop heading position", "options": [
      { "value": "heading-left", "label": "Heading left" },
      { "value": "heading-above", "label": "Heading above" }
    ], "default": "heading-left" },
    { "type": "range", "id": "max_width", "label": "Maximum width", "min": 960, "max": 1600, "step": 20, "unit": "px", "default": 1360 },
    { "type": "range", "id": "column_gap", "label": "Heading and grid gap", "min": 24, "max": 120, "step": 4, "unit": "px", "default": 64 },
    { "type": "range", "id": "card_min_height", "label": "Minimum card height", "min": 100, "max": 260, "step": 10, "unit": "px", "default": 150 },
    { "type": "range", "id": "card_padding", "label": "Card padding", "min": 16, "max": 48, "step": 2, "unit": "px", "default": 28 },
    { "type": "range", "id": "padding_top", "label": "Top spacing", "min": 0, "max": 180, "step": 4, "unit": "px", "default": 64 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom spacing", "min": 0, "max": 180, "step": 4, "unit": "px", "default": 64 },
    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "background", "label": "Background", "default": "#24482d" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#fafaf8" },
    { "type": "color", "id": "muted_color", "label": "Muted text", "default": "#c1c9be" },
    { "type": "color", "id": "eyebrow_color", "label": "Eyebrow", "default": "#f4ecd8" },
    { "type": "color", "id": "border_color", "label": "Grid lines", "default": "#55705c" }
  ],
  "blocks": [
    {
      "type": "audience",
      "name": "Perfect for item",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Beauty and fragrance" },
        { "type": "richtext", "id": "text", "label": "Description", "default": "<p>High-touch launches, discovery sets, and gifting moments that need a memorable reveal.</p>" }
      ]
    }
  ],
  "presets": [
    {
      "name": "RR PDP - Perfect for",
      "blocks": [
        { "type": "audience" },
        { "type": "audience", "settings": { "heading": "Holiday and gifting", "text": "<p>Seasonal campaigns, advent formats, and premium gifting programs built to hold attention.</p>" } },
        { "type": "audience", "settings": { "heading": "Retail launches", "text": "<p>Distinctive structures that translate a product story into a strong shelf presence.</p>" } },
        { "type": "audience", "settings": { "heading": "Lifestyle collections", "text": "<p>Coordinated packaging suites for products designed to live beautifully in the home.</p>" } }
      ]
    }
  ]
}
{% endschema %}
