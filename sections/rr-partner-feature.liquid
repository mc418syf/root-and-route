{%- liquid
  assign image_block = section.blocks | where: 'type', 'image' | first
  assign has_image = false
  if image_block != blank
    if image_block.settings.image != blank or request.design_mode
      assign has_image = true
    endif
  endif

  assign image_ratio = '4 / 5'
  if image_block != blank
    case image_block.settings.aspect_ratio
      when 'adapt'
        if image_block.settings.image != blank
          assign image_ratio = image_block.settings.image.aspect_ratio
        endif
      when 'square'
        assign image_ratio = '1 / 1'
      when 'landscape'
        assign image_ratio = '4 / 3'
      when 'wide'
        assign image_ratio = '16 / 9'
    endcase
  endif
-%}

<section
  class="rr-partner{% if has_image %} rr-partner--has-image rr-partner--text-{{ section.settings.text_position }}{% else %} rr-partner--text-only{% endif %}"
  style="
    --rr-partner-background: {{ section.settings.background }};
    --rr-partner-text: {{ section.settings.text_color }};
    --rr-partner-body: {{ section.settings.body_color }};
    --rr-partner-caption: {{ section.settings.caption_color }};
    --rr-partner-badge-background: {{ section.settings.badge_background }};
    --rr-partner-badge-text: {{ section.settings.badge_text }};
    --rr-partner-badge-border: {{ section.settings.badge_border }};
    --rr-partner-badge-hover-background: {{ section.settings.badge_hover_background }};
    --rr-partner-badge-hover-text: {{ section.settings.badge_hover_text }};
    --rr-partner-badge-radius: {{ section.settings.badge_radius }}px;
    --rr-partner-max-width: {{ section.settings.max_width }}px;
    --rr-partner-content-width: {{ section.settings.content_width }}px;
    --rr-partner-padding: {{ section.settings.padding }}px;
    --rr-partner-side-padding: {{ section.settings.side_padding }}px;
    --rr-partner-gap: {{ section.settings.column_gap }}px;
    --rr-partner-image-width: {{ section.settings.image_width }}%;
    --rr-partner-heading-size: {{ section.settings.heading_size }}px;
    --rr-partner-body-size: {{ section.settings.body_size }}px;
    --rr-partner-image-ratio: {{ image_ratio }};
    --rr-partner-image-fit: {{ image_block.settings.image_fit | default: 'cover' }};
    --rr-partner-image-position: {{ image_block.settings.image_position | default: 'center' }};
    --rr-partner-image-radius: {{ image_block.settings.corner_radius | default: 3 }}px;
    --rr-partner-image-background: {{ image_block.settings.background | default: '#efeae0' }};
  "
>
  <div class="rr-partner__inner">
    <div class="rr-partner__content rr-reveal">
      {%- if section.settings.eyebrow != blank -%}
        <p class="rr-partner__caption">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2>{{ section.settings.heading | escape }}</h2>
      {%- endif -%}
      {%- if section.settings.text != blank -%}
        <div class="rr-partner__text rte">{{ section.settings.text }}</div>
      {%- endif -%}

      <div class="rr-partner__badges" aria-label="Credentials">
        {%- for block in section.blocks -%}
          {%- if block.type == 'badge' and block.settings.label != blank -%}
            {%- liquid
              assign badge_background = section.settings.badge_background
              assign badge_text = section.settings.badge_text
              assign badge_border = section.settings.badge_border
              if block.settings.custom_colors
                assign badge_background = block.settings.background
                assign badge_text = block.settings.text_color
                assign badge_border = block.settings.border_color
              endif
            -%}
            {%- if block.settings.link != blank -%}
              <a
                class="rr-partner__badge"
                href="{{ block.settings.link }}"
                style="--badge-background: {{ badge_background }}; --badge-text: {{ badge_text }}; --badge-border: {{ badge_border }};"
                {{ block.shopify_attributes }}
              >
                {{ block.settings.label | escape }}
              </a>
            {%- else -%}
              <span
                class="rr-partner__badge"
                style="--badge-background: {{ badge_background }}; --badge-text: {{ badge_text }}; --badge-border: {{ badge_border }};"
                {{ block.shopify_attributes }}
              >
                {{ block.settings.label | escape }}
              </span>
            {%- endif -%}
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>

    {%- if has_image -%}
      <div class="rr-partner__media rr-reveal" {{ image_block.shopify_attributes }}>
        {%- if image_block.settings.image != blank -%}
          {%- assign image_alt = image_block.settings.alt | default: image_block.settings.image.alt -%}
          {{
            image_block.settings.image
            | image_url: width: 1600
            | image_tag:
              loading: 'lazy',
              widths: '480, 720, 960, 1200, 1600',
              sizes: '(min-width: 990px) 48vw, 100vw',
              alt: image_alt
          }}
        {%- else -%}
          <div class="rr-partner__image-placeholder">
            {{ 'image' | placeholder_svg_tag }}
            <span>{{ image_block.settings.placeholder | escape }}</span>
          </div>
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>
</section>

{% stylesheet %}
  .rr-partner {
    background: var(--rr-partner-background);
    border-top: 1px solid rgb(20 20 20 / 0.08);
    color: var(--rr-partner-text);
    font-family: var(--font-body--family);
    padding: var(--rr-partner-padding) var(--rr-partner-side-padding);
  }

  .rr-partner * {
    box-sizing: border-box;
  }

  .rr-partner__inner {
    margin: 0 auto;
    max-width: var(--rr-partner-max-width);
  }

  .rr-partner--text-only .rr-partner__content {
    max-width: var(--rr-partner-content-width);
  }

  .rr-partner--has-image .rr-partner__inner {
    align-items: center;
    display: grid;
    gap: var(--rr-partner-gap);
    grid-template-columns: minmax(0, var(--rr-partner-image-width)) minmax(0, 1fr);
    grid-template-areas: 'media content';
  }

  .rr-partner--has-image.rr-partner--text-left .rr-partner__inner {
    grid-template-columns: minmax(0, 1fr) minmax(0, var(--rr-partner-image-width));
    grid-template-areas: 'content media';
  }

  .rr-partner__content {
    grid-area: content;
  }

  .rr-partner__media {
    aspect-ratio: var(--rr-partner-image-ratio);
    background: var(--rr-partner-image-background);
    border-radius: var(--rr-partner-image-radius);
    grid-area: media;
    min-height: 260px;
    overflow: hidden;
  }

  .rr-partner__media > img,
  .rr-partner__image-placeholder,
  .rr-partner__image-placeholder svg {
    height: 100%;
    width: 100%;
  }

  .rr-partner__media > img {
    object-fit: var(--rr-partner-image-fit);
    object-position: var(--rr-partner-image-position);
  }

  .rr-partner__image-placeholder {
    align-items: center;
    color: rgb(20 20 20 / 0.48);
    display: flex;
    justify-content: center;
    position: relative;
  }

  .rr-partner__image-placeholder svg {
    left: 0;
    object-fit: cover;
    position: absolute;
    top: 0;
  }

  .rr-partner__image-placeholder span {
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.12em;
    padding: 24px;
    position: relative;
    text-align: center;
    text-transform: uppercase;
    z-index: 1;
  }

  .rr-partner__caption {
    color: var(--rr-partner-caption);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.2em;
    line-height: 1.4;
    margin: 0;
    text-transform: uppercase;
  }

  .rr-partner h2 {
    color: var(--rr-partner-text);
    font-family: var(--font-heading--family);
    font-size: clamp(32px, 4vw, var(--rr-partner-heading-size));
    font-weight: 400;
    letter-spacing: 0;
    line-height: 1.12;
    margin: 28px 0 0;
    max-width: 1100px;
  }

  .rr-partner__text {
    color: var(--rr-partner-body);
    font-size: var(--rr-partner-body-size);
    font-weight: 300;
    line-height: 1.75;
    margin-top: 30px;
    max-width: 960px;
  }

  .rr-partner__text p {
    margin: 0 0 20px;
  }

  .rr-partner__text p:last-child {
    margin-bottom: 0;
  }

  .rr-partner__badges {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 32px;
  }

  .rr-partner__badge {
    align-items: center;
    background: var(--badge-background, var(--rr-partner-badge-background));
    border: 1px solid var(--badge-border, var(--rr-partner-badge-border));
    border-radius: var(--rr-partner-badge-radius);
    color: var(--badge-text, var(--rr-partner-badge-text));
    display: inline-flex;
    font-size: 12px;
    font-weight: 600;
    justify-content: center;
    letter-spacing: 0.08em;
    line-height: 1;
    min-height: 38px;
    padding: 10px 18px;
    text-decoration: none;
    text-transform: uppercase;
    transition: background-color 180ms ease, border-color 180ms ease, color 180ms ease;
  }

  a.rr-partner__badge:hover {
    background: var(--rr-partner-badge-hover-background);
    border-color: var(--rr-partner-badge-hover-background);
    color: var(--rr-partner-badge-hover-text);
  }

  @media screen and (max-width: 989px) {
    .rr-partner {
      padding-left: 28px;
      padding-right: 28px;
    }

    .rr-partner--has-image .rr-partner__inner,
    .rr-partner--has-image.rr-partner--text-left .rr-partner__inner {
      gap: 44px;
      grid-template-areas: 'content' 'media';
      grid-template-columns: 1fr;
    }

    .rr-partner--text-only .rr-partner__content {
      max-width: 100%;
    }
  }

  @media screen and (max-width: 749px) {
    .rr-partner {
      padding: max(56px, calc(var(--rr-partner-padding) * 0.7)) 20px;
    }

    .rr-partner__caption {
      font-size: 9px;
    }

    .rr-partner h2 {
      font-size: max(30px, calc(var(--rr-partner-heading-size) - 2px));
      margin-top: 22px;
    }

    .rr-partner__text {
      font-size: max(14px, calc(var(--rr-partner-body-size) - 2px));
      margin-top: 24px;
    }

    .rr-partner__badges {
      gap: 9px;
      margin-top: 26px;
    }

    .rr-partner__badge {
      font-size: 10px;
      min-height: 34px;
      padding: 9px 14px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "RR partner feature",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Caption", "default": "Our Manufacturing Partnership" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Behind the structure: our partner atelier" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Root & Route Creations Inc. is the dedicated North American gateway to Guangzhou Shinelee Paper Product Co., Ltd., with over 18 years of specialized packaging experience.</p><p>Clients gain direct access to structural engineering, responsible material sourcing, and rigorous quality controls.</p>" },
    { "type": "header", "content": "Layout" },
    { "type": "select", "id": "text_position", "label": "Text position when image is added", "options": [
      { "value": "right", "label": "Right" },
      { "value": "left", "label": "Left" }
    ], "default": "right" },
    { "type": "range", "id": "image_width", "label": "Image width", "min": 35, "max": 60, "step": 5, "unit": "%", "default": 45 },
    { "type": "range", "id": "column_gap", "label": "Column gap", "min": 24, "max": 120, "step": 4, "unit": "px", "default": 72 },
    { "type": "range", "id": "max_width", "label": "Maximum width", "min": 960, "max": 1600, "step": 20, "unit": "px", "default": 1360 },
    { "type": "range", "id": "content_width", "label": "Text-only content width", "min": 600, "max": 1360, "step": 20, "unit": "px", "default": 1120 },
    { "type": "range", "id": "padding", "label": "Section spacing", "min": 0, "max": 180, "step": 4, "unit": "px", "default": 96 },
    { "type": "range", "id": "side_padding", "label": "Side spacing", "min": 20, "max": 100, "step": 4, "unit": "px", "default": 40 },
    { "type": "header", "content": "Typography" },
    { "type": "range", "id": "heading_size", "label": "Heading size", "min": 28, "max": 72, "step": 1, "unit": "px", "default": 52 },
    { "type": "range", "id": "body_size", "label": "Body size", "min": 12, "max": 24, "step": 1, "unit": "px", "default": 17 },
    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "background", "label": "Background", "default": "#ffffff" },
    { "type": "color", "id": "text_color", "label": "Heading", "default": "#141414" },
    { "type": "color", "id": "body_color", "label": "Body text", "default": "#4b4b47" },
    { "type": "color", "id": "caption_color", "label": "Caption", "default": "#9fcb6b" },
    { "type": "header", "content": "Credential badge style" },
    { "type": "color", "id": "badge_background", "label": "Background", "default": "#ffffff" },
    { "type": "color", "id": "badge_text", "label": "Text", "default": "#2f5e3a" },
    { "type": "color", "id": "badge_border", "label": "Border", "default": "#dfded8" },
    { "type": "color", "id": "badge_hover_background", "label": "Link hover background", "default": "#2f5e3a" },
    { "type": "color", "id": "badge_hover_text", "label": "Link hover text", "default": "#ffffff" },
    { "type": "range", "id": "badge_radius", "label": "Corner radius", "min": 0, "max": 40, "step": 1, "unit": "px", "default": 20 }
  ],
  "blocks": [
    {
      "type": "badge",
      "name": "Credential badge",
      "settings": [
        { "type": "text", "id": "label", "label": "Label", "default": "18+ years" },
        { "type": "url", "id": "link", "label": "Optional link" },
        { "type": "checkbox", "id": "custom_colors", "label": "Use custom colors", "default": false },
        { "type": "color", "id": "background", "label": "Background", "default": "#ffffff", "visible_if": "{{ block.settings.custom_colors }}" },
        { "type": "color", "id": "text_color", "label": "Text", "default": "#2f5e3a", "visible_if": "{{ block.settings.custom_colors }}" },
        { "type": "color", "id": "border_color", "label": "Border", "default": "#dfded8", "visible_if": "{{ block.settings.custom_colors }}" }
      ]
    },
    {
      "type": "image",
      "name": "Image",
      "limit": 1,
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "alt", "label": "Alt text" },
        { "type": "select", "id": "aspect_ratio", "label": "Aspect ratio", "options": [
          { "value": "portrait", "label": "Portrait 4:5" },
          { "value": "square", "label": "Square" },
          { "value": "landscape", "label": "Landscape 4:3" },
          { "value": "wide", "label": "Wide 16:9" },
          { "value": "adapt", "label": "Adapt to image" }
        ], "default": "portrait" },
        { "type": "select", "id": "image_fit", "label": "Image fit", "options": [
          { "value": "cover", "label": "Cover" },
          { "value": "contain", "label": "Contain" }
        ], "default": "cover" },
        { "type": "select", "id": "image_position", "label": "Image position", "options": [
          { "value": "center", "label": "Center" },
          { "value": "top", "label": "Top" },
          { "value": "bottom", "label": "Bottom" },
          { "value": "left", "label": "Left" },
          { "value": "right", "label": "Right" }
        ], "default": "center" },
        { "type": "range", "id": "corner_radius", "label": "Corner radius", "min": 0, "max": 32, "step": 1, "unit": "px", "default": 3 },
        { "type": "color", "id": "background", "label": "Empty space background", "default": "#efeae0" },
        { "type": "text", "id": "placeholder", "label": "Placeholder label", "default": "Partner factory and quality control" }
      ]
    }
  ],
  "presets": [
    {
      "name": "RR partner feature",
      "blocks": [
        { "type": "badge" },
        { "type": "badge", "settings": { "label": "Disney-Certified Vendor" } },
        { "type": "badge", "settings": { "label": "BSCI-Compliant" } },
        { "type": "badge", "settings": { "label": "FSC-Certified" } }
      ]
    }
  ]
}
{% endschema %}
