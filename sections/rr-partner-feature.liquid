<section class="rr-partner" style="background:{{ section.settings.background }};padding:{{ section.settings.padding }}px 40px"><div class="rr-wrap rr-partner__grid{% if section.settings.image_right %} image-right{% endif %}"><div class="rr-partner__media rr-reveal">{%- if section.settings.image != blank -%}{{ section.settings.image | image_url:width:1400 | image_tag:loading:'lazy',alt:section.settings.image_alt }}{%- else -%}<span>{{ section.settings.placeholder }}</span>{%- endif -%}</div><div class="rr-reveal"><div class="rr-eyebrow">{{ section.settings.eyebrow }}</div><h2>{{ section.settings.heading }}</h2><div class="rr-partner__text">{{ section.settings.text }}</div><div class="rr-partner__badges">{%- for block in section.blocks -%}<span {{ block.shopify_attributes }}>{{ block.settings.label }}</span>{%- endfor -%}</div></div></div></section>
<style>.rr-partner{border-top:1px solid var(--line)}.rr-partner__grid{align-items:center;display:grid;gap:80px;grid-template-columns:1fr 1.25fr}.rr-partner__grid.image-right>div:first-child{order:2}.rr-partner__media{align-items:center;background:var(--warm);border-radius:3px;color:#8a8a82;display:flex;font:400 12px/1.5 Jost,sans-serif;height:520px;justify-content:center;letter-spacing:.14em;overflow:hidden;padding:24px;text-align:center;text-transform:uppercase}.rr-partner h2{color:var(--ink);font:500 clamp(28px,3.6vw,44px)/1.14 Comfortaa,sans-serif;margin:28px 0 0}.rr-partner__text{color:#3a3a3a;font:300 17px/1.7 Jost,sans-serif;margin-top:28px}.rr-partner__text p{margin:0 0 18px}.rr-partner__badges{display:flex;flex-wrap:wrap;gap:14px;margin-top:24px}.rr-partner__badges span{border:1px solid var(--line);border-radius:99px;color:var(--forest);font:500 12px/1 Jost,sans-serif;letter-spacing:.06em;padding:9px 16px;text-transform:uppercase}@media(max-width:900px){.rr-partner{padding-left:28px!important;padding-right:28px!important}.rr-partner__grid{grid-template-columns:1fr}.rr-partner__grid.image-right>div:first-child{order:0}.rr-partner__media{height:400px}}@media(max-width:600px){.rr-partner{padding:72px 20px!important}.rr-partner__media{height:300px}}</style>
{% schema %}
{"name":"RR partner feature","settings":[{"type":"color","id":"background","label":"Background","default":"#ffffff"},{"type":"range","id":"padding","label":"Section spacing","min":60,"max":180,"step":4,"unit":"px","default":120},{"type":"image_picker","id":"image","label":"Image"},{"type":"checkbox","id":"image_right","label":"Place image on right","default":false},{"type":"text","id":"image_alt","label":"Image alt text","default":"Partner factory and quality control"},{"type":"text","id":"placeholder","label":"Placeholder label","default":"Partner factory floor — production line, quality control"},{"type":"text","id":"eyebrow","label":"Eyebrow","default":"Our Manufacturing Partnership"},{"type":"text","id":"heading","label":"Heading","default":"Behind the structure: our partner atelier"},{"type":"richtext","id":"text","label":"Text","default":"<p>Root & Route Creations Inc. is the dedicated North American gateway to Guangzhou Shinelee Paper Product Co., Ltd., with over 18 years of specialized packaging experience.</p><p>Clients gain direct access to structural engineering, responsible material sourcing, and rigorous quality controls.</p>"}],"blocks":[{"type":"badge","name":"Credential badge","settings":[{"type":"text","id":"label","label":"Label","default":"18+ years"}]}],"presets":[{"name":"RR partner feature","blocks":[{"type":"badge"},{"type":"badge","settings":{"label":"Disney-Certified Vendor"}},{"type":"badge","settings":{"label":"BSCI-Compliant"}},{"type":"badge","settings":{"label":"FSC-Certified"}}]}]}
{% endschema %}
