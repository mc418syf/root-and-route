{%- liquid
  assign brand_blocks = section.blocks | where: 'type', 'brand'
  assign stat_blocks = section.blocks | where: 'type', 'stat'
-%}
<section class="rr-brands" style="background:{{ section.settings.background }};padding:{{ section.settings.padding }}px 40px"><div class="rr-wrap"><div class="rr-brands__head rr-reveal"><div><div class="rr-eyebrow">{{ section.settings.eyebrow }}</div><h2 class="rr-heading">{{ section.settings.heading }}</h2></div><div class="rr-body">{{ section.settings.text }}</div></div><div class="rr-brands__wall">{%- for block in brand_blocks -%}<article class="rr-brand rr-reveal" {{ block.shopify_attributes }}>{%- if block.settings.logo != blank -%}<div class="rr-brand__logo">{{ block.settings.logo | image_url:width:500 | image_tag:loading:'lazy',alt:block.settings.name }}</div>{%- else -%}<div class="rr-brand__name">{{ block.settings.name }}</div>{%- endif -%}<div class="rr-brand__meta">{{ block.settings.category }}</div>{%- if block.settings.note != blank -%}<div class="rr-brand__note">{{ block.settings.note }}</div>{%- endif -%}</article>{%- endfor -%}</div>{%- if stat_blocks.size > 0 -%}<div class="rr-brands__stats">{%- for block in stat_blocks -%}<div class="rr-reveal" {{ block.shopify_attributes }}><strong>{{ block.settings.value }}</strong><span>{{ block.settings.label }}</span></div>{%- endfor -%}</div>{%- endif -%}<p class="rr-brands__caption">{{ section.settings.caption }}</p></div></section>
<style>.rr-brands{border-top:1px solid var(--line)}.rr-brands__head{align-items:end;display:grid;gap:80px;grid-template-columns:1.2fr .8fr}.rr-brands__head .rr-body{margin:0;max-width:500px}.rr-brands__wall{border-left:1px solid var(--line);border-top:1px solid var(--line);display:grid;grid-template-columns:repeat(3,minmax(0,1fr));margin-top:64px}.rr-brand{border-bottom:1px solid var(--line);border-right:1px solid var(--line);min-height:190px;padding:32px;position:relative}.rr-brand__logo{height:54px;max-width:180px}.rr-brand__logo img{filter:grayscale(1);object-fit:contain;object-position:left center}.rr-brand__name{color:#7d7d76;font:500 26px/1.2 Comfortaa,sans-serif}.rr-brand__meta{color:var(--forest);font:500 10px/1.3 Jost,sans-serif;letter-spacing:.2em;margin-top:24px;text-transform:uppercase}.rr-brand__note{color:var(--muted);font:300 14px/1.55 Jost,sans-serif;margin-top:12px}.rr-brands__stats{border-bottom:1px solid var(--line);display:grid;grid-template-columns:repeat(3,1fr);margin-top:64px}.rr-brands__stats>div{border-right:1px solid var(--line);display:grid;gap:8px;padding:0 32px 34px}.rr-brands__stats>div:first-child{padding-left:0}.rr-brands__stats>div:last-child{border:0}.rr-brands__stats strong{color:var(--forest);font:500 42px/1 Comfortaa,sans-serif}.rr-brands__stats span,.rr-brands__caption{color:var(--muted);font:300 14px/1.6 Jost,sans-serif}.rr-brands__caption{margin:24px 0 0}@media(max-width:850px){.rr-brands{padding-left:28px!important;padding-right:28px!important}.rr-brands__head{grid-template-columns:1fr;gap:24px}.rr-brands__wall{grid-template-columns:1fr 1fr}}@media(max-width:600px){.rr-brands{padding:72px 20px!important}.rr-brands__wall{grid-template-columns:1fr}.rr-brand{min-height:150px}.rr-brands__stats{grid-template-columns:1fr}.rr-brands__stats>div{border-bottom:1px solid var(--line);border-right:0;padding:24px 0}}</style>
{% schema %}
{"name":"RR brand wall","settings":[{"type":"color","id":"background","label":"Background","default":"#ffffff"},{"type":"range","id":"padding","label":"Section spacing","min":60,"max":180,"step":4,"unit":"px","default":120},{"type":"text","id":"eyebrow","label":"Eyebrow","default":"Brands We Work With"},{"type":"text","id":"heading","label":"Heading","default":"Trusted by teams with exacting standards"},{"type":"richtext","id":"text","label":"Introduction","default":"<p>Our partner atelier has produced packaging for visionary brands across beauty, entertainment, fragrance, retail, and lifestyle.</p>"},{"type":"text","id":"caption","label":"Trust caption","default":"Trusted by visionary brands across beauty, fragrance, and lifestyle."}],"blocks":[{"type":"brand","name":"Brand","settings":[{"type":"image_picker","id":"logo","label":"Logo"},{"type":"text","id":"name","label":"Brand name","default":"Harrods"},{"type":"text","id":"category","label":"Category","default":"Luxury retail"},{"type":"text","id":"note","label":"Optional note"}]},{"type":"stat","name":"Proof point","settings":[{"type":"text","id":"value","label":"Value","default":"18+"},{"type":"text","id":"label","label":"Label","default":"Years of manufacturing experience"}]}],"presets":[{"name":"RR brand wall","blocks":[{"type":"brand"},{"type":"brand","settings":{"name":"Disney","category":"Entertainment"}},{"type":"brand","settings":{"name":"Mentholatum","category":"Beauty & wellness"}},{"type":"brand","settings":{"name":"Glo Beauty","category":"Beauty"}},{"type":"brand","settings":{"name":"Lido","category":"Lifestyle"}},{"type":"brand","settings":{"name":"MAC","category":"Beauty"}},{"type":"stat"},{"type":"stat","settings":{"value":"6 years","label":"Disney-Certified Vendor standing"}},{"type":"stat","settings":{"value":"Global","label":"Production and delivery alignment"}}]}]}
{% endschema %}
