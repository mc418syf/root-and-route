<section class="rr-journey" id="journey" style="background:{{ section.settings.background }};padding:{{ section.settings.padding }}px {{ section.settings.side_padding }}px;"><div class="rr-wrap rr-journey__grid"><div class="rr-reveal"><div class="rr-eyebrow">{{ section.settings.eyebrow }}</div><h2 class="rr-heading">{{ section.settings.heading }}</h2><div class="rr-body" style="max-width:400px;">{{ section.settings.text }}</div><a class="rr-button" href="{{ section.settings.cta_link }}" style="margin-top:30px;">{{ section.settings.cta_label }}</a></div><div>{%- for block in section.blocks -%}<article class="rr-step rr-reveal" {{ block.shopify_attributes }}><div class="rr-step__number">{{ block.settings.number }}</div><div><h3>{{ block.settings.title }}</h3><div class="rr-body">{{ block.settings.text }}</div></div></article>{%- endfor -%}</div></div></section>
<style>.rr-journey{border-top:1px solid var(--line)}.rr-journey__grid{display:grid;gap:80px;grid-template-columns:.9fr 1.1fr}.rr-step{display:grid;gap:28px;grid-template-columns:72px 1fr;padding-bottom:44px}.rr-step__number{border-right:1px solid var(--line);color:var(--forest);font:400 22px/1 Comfortaa,Jost,sans-serif;min-height:64px}.rr-step h3{color:var(--ink);font:500 25px/1.18 Comfortaa,Jost,sans-serif;margin:0}.rr-step .rr-body{margin-top:8px}@media(max-width:900px){.rr-journey{padding-left:22px!important;padding-right:22px!important}.rr-journey__grid{grid-template-columns:1fr;gap:54px}.rr-step{grid-template-columns:54px 1fr;gap:18px}}</style>
{% schema %}
{"name":"RR journey","settings":[{"type":"color","id":"background","label":"Background","default":"#fafaf8"},{"type":"range","id":"padding","label":"Section spacing","min":60,"max":180,"step":4,"unit":"px","default":120},{"type":"range","id":"side_padding","label":"Side spacing","min":0,"max":100,"step":2,"unit":"px","default":42},{"type":"text","id":"eyebrow","label":"Eyebrow","default":"Customization Process"},{"type":"text","id":"heading","label":"Heading","default":"The Collaborative Journey"},{"type":"richtext","id":"text","label":"Text","default":"<p>Four steps from first conversation to doorstep — each one shared, reviewed, and signed off together.</p>"},{"type":"text","id":"cta_label","label":"Button label","default":"BEGIN STEP 01"},{"type":"url","id":"cta_link","label":"Button link"}],"blocks":[{"type":"step","name":"Journey step","settings":[{"type":"text","id":"number","label":"Number","default":"01"},{"type":"text","id":"title","label":"Title","default":"Discovery & Briefing"},{"type":"richtext","id":"text","label":"Description","default":"<p>We uncover the root — your brand, audience, and the moment of giving.</p>"}]}],"presets":[{"name":"RR journey","blocks":[{"type":"step"},{"type":"step","settings":{"number":"02","title":"Tactile Concepts & Structural Design","text":"<p>Materials in hand, dielines on the table — structure decided by touch.</p>"}},{"type":"step","settings":{"number":"03","title":"Prototyping & Material Selection","text":"<p>Physical samples shipped to you before a single unit is produced.</p>"}},{"type":"step","settings":{"number":"04","title":"Artisan Production & Logistics","text":"<p>Craft production with our partner atelier, delivered to Canada and beyond.</p>"}}]}]}
{% endschema %}
