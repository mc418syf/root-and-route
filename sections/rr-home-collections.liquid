{%- liquid
  assign heading_block = section.blocks | where: 'type', 'heading' | first
  assign collection_blocks = section.blocks | where: 'type', 'collection'
  assign desktop_columns = section.settings.columns_desktop | default: '3'
  case desktop_columns
    when '1'
      assign collection_image_sizes = '(min-width: 991px) 100vw, (min-width: 650px) 50vw, 100vw'
    when '2'
      assign collection_image_sizes = '(min-width: 650px) 50vw, 100vw'
    else
      assign collection_image_sizes = '(min-width: 991px) 33vw, (min-width: 650px) 50vw, 100vw'
  endcase
-%}

<section
  id="RRFeatured-{{ section.id }}"
  class="rr-featured"
  style="--rr-background:{{ section.settings.background }};--rr-image-background:{{ section.settings.image_background }};--rr-ink:{{ settings.rr_ink | default: '#141414' }};--rr-forest:{{ settings.rr_forest | default: '#2f5e3a' }};--rr-muted:{{ section.settings.muted_text }};--rr-line:{{ settings.rr_hairline | default: '#ecebe6' }};--rr-content-max:{{ settings.rr_content_max | default: 1360 }}px;--rr-side:{{ section.settings.side_padding }}px;--rr-top:{{ section.settings.padding_top }}px;--rr-bottom:{{ section.settings.padding_bottom }}px;--rr-image-height:{{ section.settings.image_height }}px;--rr-image-height-mobile:{{ section.settings.image_height_mobile }}px;--rr-columns-desktop:{{ desktop_columns }};"
>
  <span id="collections" class="rr-featured__anchor" aria-hidden="true"></span>
  <div class="rr-featured__inner">
    {%- if heading_block != blank -%}
      <header class="rr-featured__header" {{ heading_block.shopify_attributes }}>
        {%- if heading_block.settings.eyebrow != blank -%}<p class="rr-featured__eyebrow">{{ heading_block.settings.eyebrow }}</p>{%- endif -%}
        {%- if heading_block.settings.heading != blank -%}<h2>{{ heading_block.settings.heading }}</h2>{%- endif -%}
      </header>
    {%- endif -%}

    <div class="rr-featured__grid">
      {%- for block in collection_blocks -%}
        {%- liquid
          assign fallback_asset = 'rr-collection-seasonal.jpg'
          case block.settings.fallback
            when 'retail'
              assign fallback_asset = 'rr-collection-retail.jpg'
            when 'bundles'
              assign fallback_asset = 'rr-collection-bundles.jpg'
          endcase
          assign collection_url = block.settings.link | default: routes.all_products_collection_url
        -%}
        <article class="rr-featured-card" {{ block.shopify_attributes }}>
          <a href="{{ collection_url }}">
            <div class="rr-featured-card__image">
              {%- if block.settings.image != blank -%}
                {{ block.settings.image | image_url: width: 1800 | image_tag: loading: 'lazy', sizes: collection_image_sizes, alt: block.settings.image_alt }}
              {%- else -%}
                <img
                  src="{{ fallback_asset | asset_url }}"
                  alt="{{ block.settings.image_alt | default: block.settings.title | escape }}"
                  loading="lazy"
                  width="800"
                  height="{% if block.settings.fallback == 'bundles' %}1198{% else %}1200{% endif %}"
                >
              {%- endif -%}
            </div>
            <div class="rr-featured-card__copy">
              {%- if block.settings.eyebrow != blank -%}<p class="rr-featured__eyebrow">{{ block.settings.eyebrow }}</p>{%- endif -%}
              <div class="rr-featured-card__title-row">
                <h3>{{ block.settings.title }}</h3>
                {%- if block.settings.show_arrow -%}<span aria-hidden="true">&rarr;</span>{%- endif -%}
              </div>
              {%- if block.settings.text != blank -%}<div class="rr-featured-card__text">{{ block.settings.text }}</div>{%- endif -%}
            </div>
          </a>
        </article>
      {%- endfor -%}
    </div>
  </div>
</section>

<style>
  #RRFeatured-{{ section.id }} { background:var(--rr-background); border-top:{% if section.settings.show_top_border %}1px solid var(--rr-line){% else %}0{% endif %}; color:var(--rr-ink); font-family:Jost,system-ui,sans-serif; padding:var(--rr-top) var(--rr-side) var(--rr-bottom); position:relative; }
  #RRFeatured-{{ section.id }} .rr-featured__anchor { left:0; position:absolute; top:0; }
  #RRFeatured-{{ section.id }} * { box-sizing:border-box; }
  #RRFeatured-{{ section.id }} .rr-featured__inner { margin:0 auto; max-width:var(--rr-content-max); }
  #RRFeatured-{{ section.id }} .rr-featured__header { margin-bottom:58px; max-width:980px; }
  #RRFeatured-{{ section.id }} .rr-featured__eyebrow { color:var(--rr-forest); font-size:11px; font-weight:500; letter-spacing:.3em; line-height:1.35; margin:0; text-transform:uppercase; }
  #RRFeatured-{{ section.id }} .rr-featured__header h2 { color:var(--rr-ink); font-family:Comfortaa,Jost,sans-serif; font-size:62px; font-weight:500; letter-spacing:0; line-height:1.08; margin:22px 0 0; }
  #RRFeatured-{{ section.id }} .rr-featured__grid { display:grid; gap:30px; grid-template-columns:repeat(var(--rr-columns-desktop),minmax(0,1fr)); }
  #RRFeatured-{{ section.id }} .rr-featured-card a { color:inherit; display:block; text-decoration:none; }
  #RRFeatured-{{ section.id }} .rr-featured-card__image { background:var(--rr-image-background); height:var(--rr-image-height); overflow:hidden; }
  #RRFeatured-{{ section.id }} .rr-featured-card__image img { display:block; height:100%; object-fit:cover; transition:transform .65s cubic-bezier(.22,1,.36,1); width:100%; }
  #RRFeatured-{{ section.id }} .rr-featured-card:hover .rr-featured-card__image img { transform:scale(1.025); }
  #RRFeatured-{{ section.id }} .rr-featured-card__copy { padding-top:18px; }
  #RRFeatured-{{ section.id }} .rr-featured-card__title-row { align-items:center; display:flex; gap:16px; justify-content:space-between; margin-top:9px; }
  #RRFeatured-{{ section.id }} .rr-featured-card h3 { color:var(--rr-ink); font-family:Comfortaa,Jost,sans-serif; font-size:21px; font-weight:500; letter-spacing:0; line-height:1.3; margin:0; }
  #RRFeatured-{{ section.id }} .rr-featured-card__title-row span { color:var(--rr-forest); flex:0 0 auto; font-size:22px; transition:transform .25s ease; }
  #RRFeatured-{{ section.id }} .rr-featured-card:hover .rr-featured-card__title-row span { transform:translateX(4px); }
  #RRFeatured-{{ section.id }} .rr-featured-card__text { color:var(--rr-muted); font-size:14px; font-weight:300; line-height:1.72; margin-top:9px; }
  #RRFeatured-{{ section.id }} .rr-featured-card__text p { margin:0; }
  @media(max-width:990px) {
    #RRFeatured-{{ section.id }} { --rr-side:28px!important; }
    #RRFeatured-{{ section.id }} .rr-featured__header h2 { font-size:50px; }
    #RRFeatured-{{ section.id }} .rr-featured__grid { grid-template-columns:repeat(2,minmax(0,1fr)); row-gap:48px; }
  }
  @media(max-width:649px) {
    #RRFeatured-{{ section.id }} { --rr-side:20px!important; --rr-top:76px!important; --rr-bottom:76px!important; }
    #RRFeatured-{{ section.id }} .rr-featured__header { margin-bottom:38px; }
    #RRFeatured-{{ section.id }} .rr-featured__header h2 { font-size:40px; }
    #RRFeatured-{{ section.id }} .rr-featured__grid { grid-template-columns:1fr; }
    #RRFeatured-{{ section.id }} .rr-featured-card__image { height:var(--rr-image-height-mobile); }
  }
</style>

{% schema %}
{
  "name": "RR featured collections",
  "max_blocks": 7,
  "settings": [
    { "type": "color", "id": "background", "label": "Background", "default": "#ffffff" },
    { "type": "color", "id": "image_background", "label": "Image placeholder", "default": "#efeae0" },
    { "type": "color", "id": "muted_text", "label": "Description color", "default": "#8a8a82" },
    { "type": "checkbox", "id": "show_top_border", "label": "Show top border", "default": false },
    { "type": "select", "id": "columns_desktop", "label": "Desktop collections per row", "options": [{ "value": "1", "label": "1" }, { "value": "2", "label": "2" }, { "value": "3", "label": "3" }], "default": "3" },
    { "type": "range", "id": "padding_top", "label": "Top spacing", "min": 40, "max": 180, "step": 4, "unit": "px", "default": 104 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom spacing", "min": 40, "max": 180, "step": 4, "unit": "px", "default": 96 },
    { "type": "range", "id": "side_padding", "label": "Side spacing", "min": 16, "max": 100, "step": 2, "unit": "px", "default": 42 },
    { "type": "range", "id": "image_height", "label": "Desktop image height", "min": 260, "max": 620, "step": 10, "unit": "px", "default": 370 },
    { "type": "range", "id": "image_height_mobile", "label": "Mobile image height", "min": 240, "max": 520, "step": 10, "unit": "px", "default": 330 }
  ],
  "blocks": [
    {
      "type": "heading",
      "name": "Section heading",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Explore our core packaging styles, crafted by our partner atelier" },
        { "type": "inline_richtext", "id": "heading", "label": "Heading", "default": "Signature Collections" }
      ]
    },
    {
      "type": "collection",
      "name": "Collection card",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "image_alt", "label": "Image alt text", "default": "Root & Route packaging collection" },
        { "type": "select", "id": "fallback", "label": "Default image", "options": [{ "value": "seasonal", "label": "Seasonal" }, { "value": "retail", "label": "Retail innovation" }, { "value": "bundles", "label": "Bundles" }], "default": "seasonal" },
        { "type": "text", "id": "eyebrow", "label": "Category", "default": "Seasonal" },
        { "type": "text", "id": "title", "label": "Title", "default": "Advent & Countdown Boxes" },
        { "type": "richtext", "id": "text", "label": "Description", "default": "<p>Multi-drawer interactive structures engineered to anchor holiday campaigns and high-engagement product launches.</p>" },
        { "type": "url", "id": "link", "label": "Link" },
        { "type": "checkbox", "id": "show_arrow", "label": "Show arrow", "default": true }
      ]
    }
  ],
  "presets": [
    {
      "name": "RR featured collections",
      "blocks": [
        { "type": "heading" },
        { "type": "collection" },
        { "type": "collection", "settings": { "fallback": "retail", "eyebrow": "Retail Innovation", "title": "Collapsible Magnetic Boxes", "text": "<p>Premium rigid packaging built with space-saving technology to ship completely flat, reducing storage and logistics costs.</p>" } },
        { "type": "collection", "settings": { "fallback": "bundles", "eyebrow": "Bundles", "title": "Coordinated Gift Suites", "text": "<p>Fully matched packaging ensembles combining rigid boxes, retail bags, and branded accessories.</p>" } }
      ]
    }
  ]
}
{% endschema %}
