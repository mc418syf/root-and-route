<section class="rr-collections" id="collections" style="background:{{ section.settings.background }};border-top:1px solid var(--line);padding:{{ section.settings.padding }}px {{ section.settings.side_padding }}px;">
  <div class="rr-wrap"><div class="rr-reveal" style="align-items:end;display:flex;gap:24px;justify-content:space-between;margin-bottom:46px;"><div><div class="rr-eyebrow">{{ section.settings.eyebrow }}</div><h2 class="rr-heading">{{ section.settings.heading }}</h2></div><div class="rr-eyebrow" style="color:var(--sage);">{{ section.settings.kicker }}</div></div>
  <div class="rr-collection-grid">{%- for block in section.blocks -%}<article class="rr-reveal rr-collection" {{ block.shopify_attributes }}><a href="{{ block.settings.link }}"><div class="rr-collection__image">{%- if block.settings.image != blank -%}{{ block.settings.image | image_url: width:1000 | image_tag: loading:'lazy', sizes:'(min-width:900px) 33vw, 100vw', alt:block.settings.title }}{%- else -%}<img src="{{ 'rr-collection-' | append: block.settings.fallback | append: '.jpg' | asset_url }}" alt="{{ block.settings.title | escape }}">{%- endif -%}</div><div class="rr-collection__body"><div class="rr-eyebrow">{{ block.settings.eyebrow }}</div><h3>{{ block.settings.title }} <span>→</span></h3><div class="rr-body">{{ block.settings.text }}</div></div></a></article>{%- endfor -%}</div></div>
</section>
<style>.rr-collection-grid{display:grid;gap:32px;grid-template-columns:repeat(3,minmax(0,1fr))}.rr-collection__image{background:var(--warm);height:380px;overflow:hidden}.rr-collection__image img{transition:transform .8s ease}.rr-collection:hover .rr-collection__image img{transform:scale(1.04)}.rr-collection__body{padding-top:18px}.rr-collection h3{color:var(--ink);font:500 25px/1.18 Comfortaa,Jost,sans-serif;margin:12px 0 0}.rr-collection h3 span{color:var(--forest);opacity:0;transform:translateX(-6px);display:inline-block;transition:opacity .25s ease,transform .25s ease}.rr-collection:hover h3 span{opacity:1;transform:none}.rr-collection .rr-body{margin-top:10px}@media(max-width:900px){.rr-collections{padding-left:22px!important;padding-right:22px!important}.rr-collections>div>div:first-child{align-items:flex-start;flex-direction:column}.rr-collection-grid{grid-template-columns:1fr 1fr}}@media(max-width:600px){.rr-collections{padding-top:78px!important;padding-bottom:78px!important}.rr-collection-grid{grid-template-columns:1fr}.rr-collection__image{height:330px}}</style>
{% schema %}
{"name":"RR collections","settings":[{"type":"color","id":"background","label":"Background","default":"#ffffff"},{"type":"range","id":"padding","label":"Section spacing","min":60,"max":180,"step":4,"unit":"px","default":120},{"type":"range","id":"side_padding","label":"Side spacing","min":0,"max":100,"step":2,"unit":"px","default":42},{"type":"text","id":"eyebrow","label":"Eyebrow","default":"Curated Collections"},{"type":"text","id":"heading","label":"Heading","default":"Three ways to be remembered"},{"type":"text","id":"kicker","label":"Kicker","default":"2026 Portfolio"}],"blocks":[{"type":"collection","name":"Collection","settings":[{"type":"image_picker","id":"image","label":"Image"},{"type":"text","id":"fallback","label":"Fallback asset name","default":"seasonal"},{"type":"text","id":"eyebrow","label":"Eyebrow","default":"01 / Holiday Countdown"},{"type":"text","id":"title","label":"Title","default":"Advent & countdown boxes"},{"type":"richtext","id":"text","label":"Description","default":"<p>Twelve to twenty-five doors of anticipation — engineered drawers, damped lids, and a reveal worth filming.</p>"},{"type":"url","id":"link","label":"Link"}]}],"presets":[{"name":"RR collections","blocks":[{"type":"collection"},{"type":"collection"},{"type":"collection"}]}]}
{% endschema %}
