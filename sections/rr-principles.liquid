<section class="rr-principles" style="background:{{ section.settings.background }};padding:{{ section.settings.padding }}px 40px"><div class="rr-wrap"><div class="rr-reveal rr-section-copy"><div class="rr-eyebrow">{{ section.settings.eyebrow }}</div><h2 class="rr-heading">{{ section.settings.heading }}</h2></div><div class="rr-principles__grid">{%- for block in section.blocks -%}<article class="rr-reveal" {{ block.shopify_attributes }}>{%- if section.settings.show_mark -%}<img src="{{ 'rr-logo-mark.svg' | asset_url }}" alt="">{%- endif -%}<h3>{{ block.settings.title }}</h3><div class="rr-body">{{ block.settings.text }}</div></article>{%- endfor -%}</div></div></section>
<style>.rr-principles{border-top:1px solid var(--line)}.rr-principles__grid{display:grid;gap:48px;grid-template-columns:repeat(3,minmax(0,1fr));margin-top:64px}.rr-principles__grid img{height:30px;width:30px}.rr-principles h3{color:var(--ink);font:600 22px/1.3 Comfortaa,sans-serif;margin:16px 0 0}.rr-principles .rr-body{margin-top:14px}@media(max-width:800px){.rr-principles{padding-left:28px!important;padding-right:28px!important}.rr-principles__grid{grid-template-columns:1fr 1fr}}@media(max-width:600px){.rr-principles{padding:72px 20px!important}.rr-principles__grid{grid-template-columns:1fr;margin-top:44px}}</style>
{% schema %}
{"name":"RR principles","settings":[{"type":"color","id":"background","label":"Background","default":"#fafaf8"},{"type":"range","id":"padding","label":"Section spacing","min":20,"max":180,"step":4,"unit":"px","default":120},{"type":"text","id":"eyebrow","label":"Eyebrow","default":"Our Principles"},{"type":"text","id":"heading","label":"Heading","default":"What we believe"},{"type":"checkbox","id":"show_mark","label":"Show leaf marks","default":true}],"blocks":[{"type":"principle","name":"Principle","settings":[{"type":"text","id":"title","label":"Title","default":"Design without assumptions"},{"type":"richtext","id":"text","label":"Text","default":"<p>Not every product needs to fit an existing packaging template. Sometimes the right structure hasn't been created yet.</p>"}]}],"presets":[{"name":"RR principles","blocks":[{"type":"principle"},{"type":"principle"},{"type":"principle"}]}]}
{% endschema %}
