{%- liquid
  assign specification_product = closest.product | default: product
  assign metafield_namespace = section.settings.metafield_namespace | strip
-%}

<section
  class="rr-pdp-component rr-pdp-specifications"
  style="
    --rr-pdp-background: {{ section.settings.background }};
    --rr-pdp-text: {{ section.settings.text_color }};
    --rr-pdp-muted: {{ section.settings.muted_color }};
    --rr-pdp-accent: {{ section.settings.accent }};
    --rr-pdp-line: {{ section.settings.border_color }};
    --rr-pdp-max-width: {{ section.settings.max_width }}px;
    --rr-pdp-padding-top: {{ section.settings.padding_top }}px;
    --rr-pdp-padding-bottom: {{ section.settings.padding_bottom }}px;
    --rr-pdp-column-gap: {{ section.settings.column_gap }}px;
    --rr-pdp-heading-size: {{ section.settings.heading_size }}px;
    --rr-pdp-body-size: {{ section.settings.body_size }}px;
  "
>
  <div class="rr-pdp-component__inner rr-pdp-component__split">
    <header>
      {%- if section.settings.eyebrow != blank -%}<p class="rr-pdp-component__eyebrow">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
      {%- if section.settings.heading != blank -%}<h2>{{ section.settings.heading | escape }}</h2>{%- endif -%}
      {%- if section.settings.text != blank -%}<div class="rr-pdp-component__intro rte">{{ section.settings.text }}</div>{%- endif -%}
    </header>

    <dl class="rr-pdp-specifications__list">
      {%- for block in section.blocks -%}
        {%- liquid
          assign metafield_key = block.settings.metafield_key | strip
          assign specification_metafield = blank
          if metafield_namespace != blank and metafield_key != blank
            assign specification_metafield = specification_product.metafields[metafield_namespace][metafield_key]
          endif
        -%}
        {%- if specification_metafield != blank or block.settings.value != blank -%}
          <div class="rr-pdp-specifications__row" {{ block.shopify_attributes }}>
            <dt>{{ block.settings.label | escape }}</dt>
            <dd>
              {%- if specification_metafield != blank -%}
                {%- if specification_metafield.type == 'rich_text_field' -%}
                  {{ specification_metafield | metafield_tag }}
                {%- elsif specification_metafield.type contains 'list.' -%}
                  {{ specification_metafield.value | join: ', ' | escape }}
                {%- else -%}
                  {{ specification_metafield.value | escape | newline_to_br }}
                {%- endif -%}
              {%- else -%}
                {{ block.settings.value | escape | newline_to_br }}
              {%- endif -%}
            </dd>
          </div>
        {%- endif -%}
      {%- endfor -%}
    </dl>
  </div>
</section>

{% schema %}
{
  "name": "RR PDP - Specification",
  "max_blocks": 10,
  "enabled_on": { "templates": ["product"] },
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Material and finish" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Specification" },
    { "type": "richtext", "id": "text", "label": "Description", "default": "<p>Final construction and finish are confirmed through sampling before production.</p>" },
    { "type": "header", "content": "Product metafields" },
    { "type": "text", "id": "metafield_namespace", "label": "Metafield namespace", "default": "custom", "info": "Rows use this namespace and their metafield key. The manual value is used when the metafield is empty." },
    { "type": "header", "content": "Typography" },
    { "type": "range", "id": "heading_size", "label": "Heading size", "min": 28, "max": 72, "step": 1, "unit": "px", "default": 52 },
    { "type": "range", "id": "body_size", "label": "Body size", "min": 12, "max": 24, "step": 1, "unit": "px", "default": 15 },
    { "type": "header", "content": "Layout" },
    { "type": "range", "id": "max_width", "label": "Maximum width", "min": 960, "max": 1600, "step": 20, "unit": "px", "default": 1360 },
    { "type": "range", "id": "column_gap", "label": "Column gap", "min": 24, "max": 120, "step": 4, "unit": "px", "default": 72 },
    { "type": "range", "id": "padding_top", "label": "Top spacing", "min": 0, "max": 180, "step": 4, "unit": "px", "default": 96 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom spacing", "min": 0, "max": 180, "step": 4, "unit": "px", "default": 96 },
    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "background", "label": "Background", "default": "#fafaf8" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#141414" },
    { "type": "color", "id": "muted_color", "label": "Muted text", "default": "#6b6b63" },
    { "type": "color", "id": "accent", "label": "Accent", "default": "#2f5e3a" },
    { "type": "color", "id": "border_color", "label": "Lines", "default": "#ecebe6" }
  ],
  "blocks": [
    {
      "type": "row",
      "name": "Specification row",
      "settings": [
        { "type": "text", "id": "label", "label": "Label", "default": "Materials" },
        { "type": "text", "id": "metafield_key", "label": "Metafield key", "default": "materials", "info": "For example: materials, printing, finishes, or customization." },
        { "type": "textarea", "id": "value", "label": "Value", "default": "FSC-certified paperboard and specialty paper options" }
      ]
    }
  ],
  "presets": [
    {
      "name": "RR PDP - Specification",
      "blocks": [
        { "type": "row" },
        { "type": "row", "settings": { "label": "Printing", "metafield_key": "printing", "value": "Offset, Pantone, digital, and specialty color matching" } },
        { "type": "row", "settings": { "label": "Finishes", "metafield_key": "finishes", "value": "Foil stamping, embossing, debossing, spot UV, and soft-touch lamination" } },
        { "type": "row", "settings": { "label": "Customization", "metafield_key": "customization", "value": "Custom structures, inserts, dimensions, and finishes" } },
        { "type": "row", "settings": { "label": "Artwork", "metafield_key": "artwork", "value": "Dielines supplied after structural approval" } }
      ]
    }
  ]
}
{% endschema %}
