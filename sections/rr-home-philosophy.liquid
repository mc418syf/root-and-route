<section class="rr-philosophy" id="about" style="background:{{ section.settings.background }};padding:{{ section.settings.padding }}px {{ section.settings.side_padding }}px;">
  <div class="rr-wrap rr-philosophy__grid rr-reveal"><div class="rr-philosophy__media">{%- if section.settings.image != blank -%}{{ section.settings.image | image_url: width:1200 | image_tag: loading:'lazy', alt:section.settings.image_alt }}{%- else -%}<img src="{{ 'rr-collection-retail.jpg' | asset_url }}" alt="{{ section.settings.image_alt | escape }}">{%- endif -%}<div class="rr-dots"><span></span><span></span><span></span></div></div><div><div class="rr-eyebrow">{{ section.settings.eyebrow }}</div><h2 class="rr-philosophy__quote">{{ section.settings.heading }}</h2><div class="rr-body">{{ section.settings.text }}</div><a class="rr-link" href="{{ section.settings.link }}" style="display:inline-block;margin-top:30px;">{{ section.settings.link_label }}</a></div></div>
</section>
<style>.rr-philosophy{border-top:1px solid var(--line)}.rr-philosophy__grid{align-items:center;display:grid;gap:clamp(44px,6vw,92px);grid-template-columns:1.05fr .95fr}.rr-philosophy__media{background:var(--warm);min-height:420px;overflow:hidden;position:relative}.rr-dots{bottom:18px;display:flex;gap:7px;justify-content:center;left:0;position:absolute;right:0}.rr-dots span{background:rgba(255,255,255,.82);border-radius:99px;height:5px;width:5px}.rr-philosophy__quote{color:var(--ink);font:500 clamp(28px,3.2vw,44px)/1.22 Comfortaa,Jost,sans-serif;margin:24px 0 0;max-width:600px}@media(max-width:900px){.rr-philosophy{padding-left:22px!important;padding-right:22px!important}.rr-philosophy__grid{grid-template-columns:1fr}.rr-philosophy__media{min-height:360px}}</style>
{% schema %}
{"name":"RR philosophy","settings":[{"type":"color","id":"background","label":"Background","default":"#ffffff"},{"type":"range","id":"padding","label":"Section spacing","min":20,"max":180,"step":4,"unit":"px","default":96},{"type":"range","id":"side_padding","label":"Side spacing","min":0,"max":100,"step":2,"unit":"px","default":42},{"type":"image_picker","id":"image","label":"Image"},{"type":"text","id":"image_alt","label":"Image alt text","default":"Atelier craft photography"},{"type":"text","id":"eyebrow","label":"Eyebrow","default":"The Philosophy"},{"type":"text","id":"heading","label":"Heading","default":"Packaging isn't the final step. It's the beginning of every customer's first impression."},{"type":"richtext","id":"text","label":"Text","default":"<p>Root & Route is the Canadian studio of an atelier that has crafted for the world's most exacting beauty and lifestyle brands. We bring that standard here — with conscious materials, FSC-certified papers, and structures engineered to be kept, not discarded.</p>"},{"type":"text","id":"link_label","label":"Link label","default":"READ THE MANIFESTO →"},{"type":"url","id":"link","label":"Link"}],"presets":[{"name":"RR philosophy"}]}
{% endschema %}
