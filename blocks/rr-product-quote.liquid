{%- liquid
  assign quote_product = closest.product | default: product
  assign quote_base_url = block.settings.link | default: '/pages/contact'
  assign query_separator = '?'

  if quote_base_url contains '?'
    assign query_separator = '&'
  endif

  capture quote_url
    echo quote_base_url
    echo query_separator
    echo 'product='
    echo quote_product.title | url_encode
    echo '&product_handle='
    echo quote_product.handle | url_encode
  endcapture
-%}

<div
  class="rr-product-quote rr-product-quote--{{ block.settings.alignment }}"
  style="
    --rr-quote-background: {{ block.settings.background }};
    --rr-quote-text: {{ block.settings.text_color }};
    --rr-quote-background-hover: {{ block.settings.background_hover }};
    --rr-quote-text-hover: {{ block.settings.text_hover }};
    --rr-quote-width: {% if block.settings.full_width %}100%{% else %}fit-content{% endif %};
  "
  {{ block.shopify_attributes }}
>
  <a class="rr-product-quote__button" href="{{ quote_url | strip | escape }}">
    <span>{{ block.settings.label | escape }}</span>
    {%- if block.settings.show_arrow -%}
      <svg aria-hidden="true" viewBox="0 0 16 12" fill="none">
        <path d="M1 6h13M10 1.5 14.5 6 10 10.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    {%- endif -%}
  </a>
</div>

{% stylesheet %}
  .rr-product-quote {
    display: flex;
    width: 100%;
  }

  .rr-product-quote--left {
    justify-content: flex-start;
  }

  .rr-product-quote--center {
    justify-content: center;
  }

  .rr-product-quote--right {
    justify-content: flex-end;
  }

  .rr-product-quote__button {
    align-items: center;
    background: var(--rr-quote-background);
    border: 1px solid var(--rr-quote-background);
    border-radius: 999px;
    color: var(--rr-quote-text);
    display: inline-flex;
    font-family: var(--font-body--family);
    font-size: 12px;
    font-weight: 500;
    gap: 10px;
    justify-content: center;
    letter-spacing: 0.12em;
    min-height: 46px;
    padding: 12px 24px;
    text-decoration: none;
    text-transform: uppercase;
    transition: background-color 180ms ease, border-color 180ms ease, color 180ms ease;
    width: var(--rr-quote-width);
  }

  .rr-product-quote__button:hover {
    background: var(--rr-quote-background-hover);
    border-color: var(--rr-quote-background-hover);
    color: var(--rr-quote-text-hover);
  }

  .rr-product-quote__button svg {
    flex: 0 0 auto;
    height: 12px;
    width: 16px;
  }

  @media screen and (max-width: 749px) {
    .rr-product-quote__button {
      font-size: 10px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "RR product quote",
  "tag": null,
  "settings": [
    {
      "type": "text",
      "id": "label",
      "label": "Button label",
      "default": "GET A QUOTE"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Quote page",
      "info": "Defaults to /pages/contact. The product title and handle are added to the URL."
    },
    {
      "type": "checkbox",
      "id": "show_arrow",
      "label": "Show arrow",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "full_width",
      "label": "Full width",
      "default": false
    },
    {
      "type": "text_alignment",
      "id": "alignment",
      "label": "Alignment",
      "default": "left"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background",
      "label": "Background",
      "default": "#2f5e3a"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "background_hover",
      "label": "Hover background",
      "default": "#24482d"
    },
    {
      "type": "color",
      "id": "text_hover",
      "label": "Hover text",
      "default": "#ffffff"
    }
  ],
  "presets": [
    {
      "name": "RR product quote",
      "category": "Product"
    }
  ]
}
{% endschema %}
