{% doc %}
  @prompt
    a image with description black with the ability to add header and body and two buttons under description. ability to place text section above, under, and below the hero images. ability to add multiple images. ability to change images padding
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-hero-image-block-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    background-color: {{ block.settings.background_color }};
  }

  .ai-hero-image-container-{{ ai_gen_id }} {
    display: flex;
    flex-direction: {{ block.settings.layout }};
    align-items: center;
    gap: {{ block.settings.content_gap }}px;
    padding: {{ block.settings.section_padding }}px;
  }

  .ai-hero-image-wrapper-{{ ai_gen_id }} {
    flex: 1;
    position: relative;
  }

  .ai-hero-image-{{ ai_gen_id }} {
    width: 100%;
    height: auto;
    display: block;
    border-radius: {{ block.settings.image_border_radius }}px;
    padding: {{ block.settings.image_padding }}px;
  }

  .ai-hero-image-placeholder-{{ ai_gen_id }} {
    width: 100%;
    background-color: #f4f4f4;
    border-radius: {{ block.settings.image_border_radius }}px;
    padding: {{ block.settings.image_padding }}px;
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 400px;
  }

  .ai-hero-image-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    max-width: 500px;
    max-height: 500px;
  }

  .ai-hero-content-{{ ai_gen_id }} {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: {{ block.settings.text_gap }}px;
    color: {{ block.settings.text_color }};
  }

  .ai-hero-header-{{ ai_gen_id }} {
    font-size: {{ block.settings.header_size }}px;
    font-weight: 600;
    margin: 0;
    color: {{ block.settings.text_color }};
  }

  .ai-hero-body-{{ ai_gen_id }} {
    font-size: {{ block.settings.body_size }}px;
    line-height: 1.6;
    margin: 0;
    color: {{ block.settings.text_color }};
  }

  .ai-hero-buttons-{{ ai_gen_id }} {
    display: flex;
    gap: {{ block.settings.button_gap }}px;
    flex-wrap: wrap;
  }

  .ai-hero-button-{{ ai_gen_id }} {
    padding: {{ block.settings.button_padding }}px {{ block.settings.button_padding | times: 2 }}px;
    border-radius: {{ block.settings.button_border_radius }}px;
    text-decoration: none;
    font-size: {{ block.settings.button_text_size }}px;
    font-weight: 500;
    cursor: pointer;
    border: none;
    display: inline-block;
    transition: all 0.3s ease;
  }

  .ai-hero-button-primary-{{ ai_gen_id }} {
    background-color: {{ block.settings.button_primary_bg }};
    color: {{ block.settings.button_primary_text }};
  }

  .ai-hero-button-primary-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_primary_hover_bg }};
    color: {{ block.settings.button_primary_hover_text }};
  }

  .ai-hero-button-secondary-{{ ai_gen_id }} {
    background-color: {{ block.settings.button_secondary_bg }};
    color: {{ block.settings.button_secondary_text }};
    border: {{ block.settings.button_secondary_border_width }}px solid {{ block.settings.button_secondary_border }};
  }

  .ai-hero-button-secondary-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_secondary_hover_bg }};
    color: {{ block.settings.button_secondary_hover_text }};
  }

  @media screen and (max-width: 749px) {
    .ai-hero-image-container-{{ ai_gen_id }} {
      flex-direction: column;
    }

    .ai-hero-header-{{ ai_gen_id }} {
      font-size: {{ block.settings.header_size | times: 0.7 }}px;
    }

    .ai-hero-body-{{ ai_gen_id }} {
      font-size: {{ block.settings.body_size | times: 0.9 }}px;
    }

    .ai-hero-buttons-{{ ai_gen_id }} {
      flex-direction: column;
      width: 100%;
    }

    .ai-hero-button-{{ ai_gen_id }} {
      width: 100%;
      text-align: center;
    }
  }
{% endstyle %}

<hero-image-block-{{ ai_gen_id }} class="ai-hero-image-block-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-hero-image-container-{{ ai_gen_id }}">
    {% if block.settings.text_position == 'above' or block.settings.text_position == 'left' %}
      <div class="ai-hero-content-{{ ai_gen_id }}">
        {% if block.settings.header != blank %}
          <h2 class="ai-hero-header-{{ ai_gen_id }}">{{ block.settings.header }}</h2>
        {% endif %}

        {% if block.settings.body != blank %}
          <div class="ai-hero-body-{{ ai_gen_id }}">{{ block.settings.body }}</div>
        {% endif %}

        {% if block.settings.button_1_text != blank or block.settings.button_2_text != blank %}
          <div class="ai-hero-buttons-{{ ai_gen_id }}">
            {% if block.settings.button_1_text != blank %}
              <a
                href="{{ block.settings.button_1_link }}"
                class="ai-hero-button-{{ ai_gen_id }} ai-hero-button-primary-{{ ai_gen_id }}"
              >
                {{ block.settings.button_1_text }}
              </a>
            {% endif %}

            {% if block.settings.button_2_text != blank %}
              <a
                href="{{ block.settings.button_2_link }}"
                class="ai-hero-button-{{ ai_gen_id }} ai-hero-button-secondary-{{ ai_gen_id }}"
              >
                {{ block.settings.button_2_text }}
              </a>
            {% endif %}
          </div>
        {% endif %}
      </div>
    {% endif %}

    <div class="ai-hero-image-wrapper-{{ ai_gen_id }}">
      {% if block.settings.image %}
        <img
          src="{{ block.settings.image | image_url: width: 2000 }}"
          alt="{{ block.settings.image.alt | escape }}"
          loading="lazy"
          width="{{ block.settings.image.width }}"
          height="{{ block.settings.image.height }}"
          class="ai-hero-image-{{ ai_gen_id }}"
        >
      {% else %}
        <div class="ai-hero-image-placeholder-{{ ai_gen_id }}">
          {{ 'hero-apparel-1' | placeholder_svg_tag }}
        </div>
      {% endif %}
    </div>

    {% if block.settings.text_position == 'below' or block.settings.text_position == 'right' %}
      <div class="ai-hero-content-{{ ai_gen_id }}">
        {% if block.settings.header != blank %}
          <h2 class="ai-hero-header-{{ ai_gen_id }}">{{ block.settings.header }}</h2>
        {% endif %}

        {% if block.settings.body != blank %}
          <div class="ai-hero-body-{{ ai_gen_id }}">{{ block.settings.body }}</div>
        {% endif %}

        {% if block.settings.button_1_text != blank or block.settings.button_2_text != blank %}
          <div class="ai-hero-buttons-{{ ai_gen_id }}">
            {% if block.settings.button_1_text != blank %}
              <a
                href="{{ block.settings.button_1_link }}"
                class="ai-hero-button-{{ ai_gen_id }} ai-hero-button-primary-{{ ai_gen_id }}"
              >
                {{ block.settings.button_1_text }}
              </a>
            {% endif %}

            {% if block.settings.button_2_text != blank %}
              <a
                href="{{ block.settings.button_2_link }}"
                class="ai-hero-button-{{ ai_gen_id }} ai-hero-button-secondary-{{ ai_gen_id }}"
              >
                {{ block.settings.button_2_text }}
              </a>
            {% endif %}
          </div>
        {% endif %}
      </div>
    {% endif %}
  </div>
</hero-image-block-{{ ai_gen_id }}>

<script>
  (function() {
    class HeroImageBlock{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
      }
    }

    customElements.define('hero-image-block-{{ ai_gen_id }}', HeroImageBlock{{ ai_gen_id }});
  })();
</script>

